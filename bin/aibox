#!/usr/bin/env bash
# aibox — persistent Docker sandboxes for Claude Code.
#
# One container per project. One shared home volume (aibox-home) holds all
# Claude state. Nothing is ever deleted without asking.
#
# Usage:
#   aibox [claude] [args...]  Shorthand for `aibox run claude`: start/attach
#                             this project's container and run Claude Code.
#                             Permission prompts are on by default, with
#                             bypass mode available in-session; pass --yolo
#                             to skip all prompts from the start. Other args
#                             pass to claude verbatim (--resume, -p,
#                             --model, ...). `aibox --resume` works too.
#   aibox run [--copy] <program> [args...]
#                             Run any program in the container (e.g.
#                             aibox run codex). With --copy (also on plain
#                             aibox/claude), a disposable container on a
#                             snapshot of the project is used instead — no
#                             bind mount, the real directory can't be
#                             touched, and the container is removed on exit
#                             (commit & push from inside to keep work).
#                             A `--` ends aibox's own flag parsing, so a
#                             literal --copy/--yolo can reach the program.
#   aibox serve               Run the sessions UI on port 45789 (dev-proxy
#                             URL): start new phone/browser-drivable
#                             sessions, resume past ones, see and stop live
#                             ones. Each session is a detached claude
#                             process in the container — it survives closing
#                             the terminal and shows up at claude.ai / the
#                             Claude app. `aibox serve stop` ends the UI and
#                             every live session.
#   aibox sessions            All projects' past sessions on one local page
#                             (opens your browser; loopback-only, runs in
#                             the foreground until Ctrl-C or its Close
#                             button). Per session: open in a terminal, copy
#                             the resume command, or make it phone-drivable.
#   aibox schedule [...]      Jobs that run inside project sandboxes on a
#                             schedule (daily HH:MM, weekdays HH:MM, every
#                             30m) or on container start, driven by launchd/
#                             cron on the host. `add`, `rm`, `approve`/`reject`
#                             proposals that a Claude session wrote, `on`/
#                             `off`, `log`. No args lists everything.
#   aibox browser [--share]   Playwright browser server on the Mac, with the
#                             real GPU, that sessions connect to for WebGL/
#                             WebGPU renders. Foreground; Ctrl-C stops it.
#                             Runs as a hidden unprivileged user, created
#                             on first run; `setup` updates Playwright.
#                             --share also prints an agent-socket link for
#                             agents elsewhere (uploads + allowed hosts
#                             only; `answer <id> allow|always|deny` answers
#                             their requests). macOS only.
#   aibox rc-resume <id>      Make one past session of this project
#                             drivable from claude.ai / the Claude app.
#   aibox shell [cmd...]      zsh in the container. One argument runs as a
#                             shell string (pipes/globs work); several run
#                             as a safely-quoted command.
#   aibox stop [--all]        Stop this project's container
#                             (--all: every aibox container + proxy).
#                             Never deletes anything; next run re-attaches.
#   aibox status              Containers with live memory + disk use,
#                             dev-server URLs, Docker disk totals, home
#                             volume size
#   aibox backup [dir]        Snapshot the aibox-home volume to a tar.gz
#                             (default dir: ~/aibox-backups)
#   aibox restore <file>      Restore a backup into aibox-home
#                             (auto safety-backup of current state first)
#   aibox update              Update the CLI; image rebuilds on next run
#   aibox version             Show versions
#   aibox help                Show this help
#
# Dev servers: anything listening on any port inside the container is
# reachable from the host browser at
#   http://<port>.<project>.aibox.localhost
# (Chrome/Edge/Firefox out of the box; Safari needs macOS 26+. No ports to
# publish, no restarts — the proxy reaches the container over the Docker
# network.) Inside the container, $AIBOX_URL_BASE holds
# "<project>.aibox.localhost[:port]", and exported ANTHROPIC_* host vars
# are forwarded.
#
# Config (~/.aibox/config, key=value, all optional):
#   node_version=24           # base image: node:<this>-bookworm
#   proxy_port=80             # host port for the dev-server proxy
#   backup_dir=~/aibox-backups
# Extra image layers: ~/.aibox/Dockerfile.extra is appended to the generated
# Dockerfile (survives image rebuilds; plain apt installs survive stop/start
# but reset when the image changes).
#
# All Claude state lives in one Docker volume (aibox-home), sliced per
# project: login, settings, and the claude binary are shared; each project
# gets a private home (ssh keys, shell history, its own sessions) that other
# projects' containers never mount. Needs Docker Engine 26+. A flat
# aibox-home (from scripts/migrate-to-v2.sh or a pre-release v2) is
# re-sliced automatically on first run (safety backup first).
# Containers are disposable; the volume is what `aibox backup` protects.
#
# (This header is the output of `aibox help` — keep it accurate.)

set -euo pipefail
unset CDPATH

# Replaced by the release workflow; left as-is = running from a git
# checkout, which behaves as version "dev".
CLI_VERSION="__CLI_VERSION__"
CONFIG_DIR="${HOME}/.aibox"
VOLUME="aibox-home"
NETWORK="aibox"
PROXY="aibox-proxy"
PROXY_IMAGE="caddy:2-alpine"
HELPER_IMAGE="alpine:3.20"

# ── Output helpers ───────────────────────────────────────────────
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  _G='\033[1;32m' _Y='\033[1;33m' _R='\033[1;31m' _D='\033[2m' _B='\033[1m' _N='\033[0m'
else
  _G='' _Y='' _R='' _D='' _B='' _N=''
fi
_ok()   { echo -e "${_G}✓${_N} $*"; }
_info() { echo -e "${_D}·${_N} $*"; }
_warn() { echo -e "${_Y}⚠${_N} $*"; }
_die()  { echo -e "${_R}✗${_N} $*" >&2; exit 1; }

# ── Config ───────────────────────────────────────────────────────
NODE_VERSION=24
PROXY_PORT=80
BACKUP_DIR="${HOME}/aibox-backups"
SHARE_RELAY="https://agentsocket.dev"
if [[ -f "${CONFIG_DIR}/config" ]]; then
  # `|| [[ -n "$k" ]]`: don't drop the last line when the file has no
  # trailing newline.
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    [[ "$k" == \#* || -z "$k" || -z "$v" ]] && continue
    v="${v/#\~/$HOME}"
    case "$k" in
      node_version) NODE_VERSION="$v" ;;
      proxy_port)   PROXY_PORT="$v" ;;
      backup_dir)   BACKUP_DIR="$v" ;;
      share_relay)  SHARE_RELAY="$v" ;;
    esac
  done < "${CONFIG_DIR}/config"
fi
mkdir -p "$CONFIG_DIR"

# ── Derived names ────────────────────────────────────────────────
PROJECT_DIR="$(pwd -P)"
SLUG="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/_/-/g')"
HASH6="$(printf '%s' "$PROJECT_DIR" | { sha256sum || shasum -a 256; } 2>/dev/null | cut -c1-6)"
# Name format aibox-<slug>-<hash6> is load-bearing: _proxy_pairs extracts
# the trailing hash6 with ${name##*-} for slug-collision URLs.
CONTAINER="aibox-${SLUG}-${HASH6}"
VERSION_TAG="$CLI_VERSION"
[[ "$VERSION_TAG" == "__CLI_VERSION__" ]] && VERSION_TAG="dev"
# VERSION_TAG also names backups (aibox-home-<tag>-<time>.tar.gz).
IMAGE="aibox:${VERSION_TAG}-node${NODE_VERSION}"

# ── Small helpers ────────────────────────────────────────────────
_require_safe_dir() {
  case "$PROJECT_DIR" in
    "$HOME"|/|/tmp|/var|/etc|/usr|/opt|/private|/private/tmp)
      _die "Refusing to sandbox ${PROJECT_DIR} — run aibox from inside a project directory." ;;
    *:*)
      _die "Project path contains ':' — docker cannot bind-mount it. Rename the directory." ;;
  esac
}

_confirm() {
  local reply
  printf '%s [y/N] ' "$1" >&2
  read -r reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

# Container state, or "absent". (docker inspect emits a stray newline on
# stdout for missing objects, so trim before defaulting.)
_state() {
  local s
  s="$(docker inspect "$1" --format '{{.State.Status}}' 2>/dev/null | tr -d '[:space:]')"
  echo "${s:-absent}"
}

# One EXIT trap for the whole script. bash keeps a single EXIT trap, so
# cleanups register here instead of overwriting each other (a Ctrl-C during
# migration used to leave .lock-migrate behind, which then blocked the very
# `aibox restore` the error message recommends). Hooks are idempotent.
EXIT_HOOKS=()
LOCKS=()
_run_exit_hooks() { local h; for h in ${EXIT_HOOKS[@]+"${EXIT_HOOKS[@]}"}; do "$h"; done; }
_on_exit() { EXIT_HOOKS+=("$1"); trap _run_exit_hooks EXIT; }
_unlock_all() { local l; for l in ${LOCKS[@]+"${LOCKS[@]}"}; do rmdir "$l" 2>/dev/null || true; done; LOCKS=(); }
# Release one lock now AND forget it: aibox lives for the whole Claude
# session, and a lock path released early is soon another invocation's —
# the exit hook must not remove that one.
_unlock() {
  local keep=() l
  for l in ${LOCKS[@]+"${LOCKS[@]}"}; do [[ "$l" == "$1" ]] || keep+=("$l"); done
  LOCKS=(${keep[@]+"${keep[@]}"})
  rmdir "$1" 2>/dev/null || true
}

# ── Docker runtime ───────────────────────────────────────────────
_ensure_docker() {
  command -v docker >/dev/null 2>&1 \
    || _die "docker CLI not found. Install a runtime first, e.g.: brew install colima docker && colima start"
  docker info >/dev/null 2>&1 && return 0
  if command -v colima >/dev/null 2>&1; then
    _info "Docker daemon not running. Starting Colima..."
    colima start
  elif [[ -d /Applications/OrbStack.app ]]; then
    _info "Docker daemon not running. Starting OrbStack..."
    open -a OrbStack
  elif [[ -d /Applications/Docker.app ]]; then
    _info "Docker daemon not running. Starting Docker Desktop..."
    open -a Docker
  else
    _die "Docker daemon not running. Start it (Linux: sudo systemctl start docker; macOS: open your Docker app) and retry."
  fi
  local i=0
  until docker info >/dev/null 2>&1; do
    (( i++ >= 60 )) && _die "Docker daemon did not come up. Try again in a moment."   # 60s
    sleep 1
  done
}

# ── Image ────────────────────────────────────────────────────────
_build_image() {
  # Unquoted heredoc so ${NODE_VERSION} interpolates — hence the \\ and
  # \$PATH escapes. Don't quote the delimiter.
  cat > "${CONFIG_DIR}/Dockerfile" <<DOCKERFILE
FROM node:${NODE_VERSION}-bookworm

RUN apt-get update \\
 && apt-get install -y --no-install-recommends zsh sudo ripgrep fzf jq less procps curl \\
 && rm -rf /var/lib/apt/lists/*

# The base image ships user 'node' at uid 1000; replace it with 'aibox'
RUN userdel -r node 2>/dev/null || true \\
 && useradd -m -u 1000 -s /usr/bin/zsh aibox \\
 && echo "aibox ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/aibox \\
 && chmod 0440 /etc/sudoers.d/aibox

ENV PATH="\$PATH:/home/aibox/.local/bin"

COPY entrypoint.sh /usr/local/bin/aibox-entrypoint
RUN chmod +x /usr/local/bin/aibox-entrypoint
ENTRYPOINT ["/usr/local/bin/aibox-entrypoint"]
CMD ["sleep", "infinity"]
DOCKERFILE
  [[ -f "${CONFIG_DIR}/Dockerfile.extra" ]] && cat "${CONFIG_DIR}/Dockerfile.extra" >> "${CONFIG_DIR}/Dockerfile"
  # Keep stray files in ~/.aibox (config, Caddyfile, caches) out of the build
  # context.
  printf '*\n!Dockerfile\n!entrypoint.sh\n' > "${CONFIG_DIR}/.dockerignore"
  cat > "${CONFIG_DIR}/entrypoint.sh" <<'ENTRYPOINT'
#!/bin/bash
set -e
rm -f /tmp/aibox-ready /tmp/aibox-onstart-done   # per-boot markers (see _run_on_start)
# /home/aibox is a named volume; normalize ownership on every container start
# (data migrated from v1 or restored from backups may carry other UIDs).
# ~/.aibox holds the host-owned proposals inbox bind mount — never chown
# into it (on Linux hosts the host user would lose the files).
find /home/aibox -mindepth 1 -maxdepth 1 ! -name .aibox -exec chown -R aibox:aibox {} + 2>/dev/null || true
chown aibox:aibox /home/aibox 2>/dev/null || true
# A fresh volume has no .zshrc — without one, the first interactive zsh
# opens the zsh-newuser-install questionnaire.
if [[ ! -e /home/aibox/.zshrc ]]; then
  printf 'autoload -Uz compinit && compinit\nPROMPT="%%F{cyan}%%1~%%f %%# "\n' > /home/aibox/.zshrc
  chown aibox:aibox /home/aibox/.zshrc
fi
# Claude Code deletes transcripts idle >30 days by default; raise that once
# so session history is permanent. Never touches an existing value, skips
# an unparseable file. This runs as root in the shared .claude slice, which
# every project can write to: a symlink planted there must never be
# followed (it could point into another project's bind mount).
node -e '
const fs=require("fs"),p="/home/aibox/.claude/settings.json";
try{if(fs.lstatSync(p).isSymbolicLink())process.exit(0)}catch(e){}
let s={};
if(fs.existsSync(p)){try{s=JSON.parse(fs.readFileSync(p,"utf8"))}catch(e){process.exit(0)}}
if(s.cleanupPeriodDays==null){s.cleanupPeriodDays=3650;fs.writeFileSync(p,JSON.stringify(s,null,2));}
' 2>/dev/null || true
chown -h aibox:aibox /home/aibox/.claude/settings.json 2>/dev/null || true
# Teach every session how to find and revive this project's past sessions.
CM=/home/aibox/.claude/CLAUDE.md
if [[ ! -L "$CM" ]] && ! grep -q 'aibox:sessions' "$CM" 2>/dev/null; then
  cat >> "$CM" <<'NOTES'

<!-- aibox:sessions -->
- Past Claude sessions of this project are JSONL files under `~/.claude/projects/*/` — grep them to find one; the filename (minus .jsonl) is the session id.
- To make a past session controllable from claude.ai / the Claude phone app: `nohup script -qfc "claude --resume <session-id> --remote-control" /dev/null >/dev/null 2>&1 &` — it appears in the claude.ai session list within seconds.
- To start a brand-new session there instead: same command with `--session-id $(cat /proc/sys/kernel/random/uuid)` in place of `--resume <session-id>`.
NOTES
  chown -h aibox:aibox "$CM" 2>/dev/null || true
fi
if [[ ! -L "$CM" ]] && ! grep -q 'aibox:schedule' "$CM" 2>/dev/null; then
  cat >> "$CM" <<'NOTES'

<!-- aibox:schedule -->
- You cannot schedule anything yourself; the host runs approved jobs inside this container. To propose one: first write the prompt file (if any), then write `~/.aibox/proposals/<name>` (name: a-z, 0-9, dashes) with two lines: the schedule (`daily 08:00`, `weekdays 18:30`, `every 30m`, `every 2h`, or `on-start`) and either `claude <prompt-file>` (a self-contained prompt file in this project — it runs later as a fresh headless session with no memory of this chat, so put everything it needs in the file) or `run <shell command>` (one line, at most 200 chars). Then tell the user to approve it with `aibox schedule approve <name>` on their machine (a dialog also offers it on a Mac); the job's output lands in ~/.aibox/schedule.log there.
NOTES
  chown -h aibox:aibox "$CM" 2>/dev/null || true
fi
# How-to for the host-side GPU browser (see `aibox browser`). Rewritten on
# every start so it tracks the aibox version; never through a symlink.
GB=/home/aibox/.claude/aibox-gpu-browser.md
if [[ ! -L "$GB" ]]; then
  cat > "$GB" <<'DOC'
# GPU browser for sessions (a Playwright server on the user's Mac)

This container has no GPU: headless Chromium here renders WebGL/WebGPU in
software (SwiftShader), slowly and with a large memory footprint. The user's
Mac can run a Playwright browser server with the real GPU (`aibox browser`).
While it runs, `~/.aibox/host/browser.url` exists in this container (a
read-only file from the Mac): line 1 is the ws URL (reachable via
host.docker.internal), line 2 the Playwright version. If connecting fails,
the server is gone: ask the user to run `aibox browser` again.

Using it:
- The client must be exactly that Playwright version. Do not change the
  project's own Playwright; use a scratch install:
  `npm i --prefix /tmp/pw playwright@<version>` and
  `require("/tmp/pw/node_modules/playwright")`.
- Connect with `chromium.connect(url, { headers: { Host: "127.0.0.1:3145" } })`
  — the server rejects any other Host value with 403.
- One Chromium is shared by all sessions: use `browser.newContext()` for
  isolation and always `browser.close()` when done (it only disconnects you).
- The browser runs on the Mac, not here, so it cannot read this container's
  files. Serve pages over HTTP: a dev server in this container is reachable
  to it as `http://<port>.<$AIBOX_URL_BASE>` (the aibox dev-server proxy).
- Save screenshots into the project directory so the user can open them.

If the file is missing and GPU rendering would matter (WebGL/WebGPU
screenshots, rendering performance), tell the user: "run `aibox browser` on
your Mac for GPU rendering", then check the file again. Without it, use
Playwright's own headless Chromium with
`--enable-unsafe-swiftshader --use-angle=swiftshader`.
DOC
  chown -h aibox:aibox "$GB" 2>/dev/null || true
fi
if [[ ! -L "$CM" ]] && ! grep -q 'aibox:browser' "$CM" 2>/dev/null; then
  cat >> "$CM" <<'NOTES'

<!-- aibox:browser -->
- GPU rendering (WebGL/WebGPU screenshots, render performance): this container has no GPU. Read `~/.claude/aibox-gpu-browser.md` — the user can run `aibox browser` on their Mac to give you a GPU-backed Playwright browser.
NOTES
  chown -h aibox:aibox "$CM" 2>/dev/null || true
fi
# The proposals mount creates ~/.aibox root-owned; hand it to the user.
chown aibox:aibox /home/aibox/.aibox 2>/dev/null || true
# First start with an empty home volume: install Claude Code into the volume
# so the binary and its self-updates persist across container recreation.
# (Anything baked into the image's home dir would be shadowed by the mount.)
if [[ ! -x /home/aibox/.local/bin/claude ]]; then
  runuser -u aibox -- bash -c 'curl -fsSL --connect-timeout 15 https://claude.ai/install.sh | bash' || true
fi
# Signals "start-up work finished" to the CLI (see _ensure_claude_bin).
touch /tmp/aibox-ready
exec "$@"
ENTRYPOINT
  _info "Building ${IMAGE} (one-time; rebuilt only when aibox is updated or node_version changes)..."
  docker build --pull -t "$IMAGE" "$CONFIG_DIR"
  _ok "Image built."
}

_ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || _build_image
}

# ── Dev-server proxy (Caddy) ─────────────────────────────────────
# One shared reverse proxy on the aibox network. Any request to
# <port>.<slug>.aibox.localhost is proxied to <container>:<port> over the
# Docker network — no ports are ever published on project containers.
# (These helpers run inside $(...) where set -e is off — keep them
# read-only.)

# All v2 project containers, oldest first (stable UTC creation time):
# "slug name" per line. Space-separated: docker inspect --format passes \t
# through literally (unlike docker ps), and none of the fields contain
# spaces.
_project_rows() {
  local ids
  ids="$(docker ps -aq --filter label=aibox.slug 2>/dev/null | tr '\n' ' ')"
  [[ -z "${ids// /}" ]] && return 0
  # shellcheck disable=SC2086
  docker inspect --format '{{.Created}} {{index .Config.Labels "aibox.slug"}} {{.Name}}' $ids 2>/dev/null \
    | sort | cut -d' ' -f2,3
}

# Emit "publiclabel name" pairs; the oldest project keeps the bare slug,
# later slug collisions get slug-hash6.
_proxy_pairs() {
  local slug name key seen=" "   # space-delimited set (bash 3.2: no assoc arrays)
  while read -r slug name; do
    name="${name#/}"   # docker inspect .Name has a leading slash
    [[ -z "$name" ]] && continue
    key="$slug"
    [[ "$seen" == *" $slug "* ]] && key="${slug}-${name##*-}"
    seen="${seen}${slug} "
    echo "$key $name"
  done < <(_project_rows)
}

_pub_label() {
  local key name
  while read -r key name; do
    [[ "$name" == "$CONTAINER" ]] && { echo "$key"; return; }
  done < <(_proxy_pairs)
  echo "$SLUG"
}

_gen_caddyfile() {
  echo "# Generated by aibox — do not edit (regenerated on every run)."
  echo "http://*.*.aibox.localhost {"
  # Caddy indexes host labels right-to-left from zero:
  # <port>.<project>.aibox.localhost → labels.3=port, labels.2=project.
  echo "    map {http.request.host.labels.2} {upstream} {"
  local key name
  while read -r key name; do
    echo "        ${key} ${name}"
  done < <(_proxy_pairs)
  echo "        default invalid-project"
  echo "    }"
  echo "    reverse_proxy {upstream}:{http.request.host.labels.3}"
  echo "}"
}

# Host port the proxy actually publishes; ":port" suffix, empty when 80.
_proxy_suffix() {
  local p
  p="$(docker port "$PROXY" 80/tcp 2>/dev/null | head -1)"
  p="${p##*:}"
  [[ -n "$p" && "$p" != "80" ]] && echo ":${p}" || true
}

# The user-facing dev-server URL pattern for $CONTAINER ($1: concrete port,
# default the "<port>" placeholder).
_dev_url() { echo "http://${1:-<port>}.$(_pub_label).aibox.localhost$(_proxy_suffix)"; }

_start_proxy_on() {  # $1 = host port; returns docker run's status
  docker run -d --name "$PROXY" --network "$NETWORK" --restart unless-stopped \
    -p "127.0.0.1:${1}:80" \
    -v "${CONFIG_DIR}/Caddyfile:/etc/caddy/Caddyfile:ro" \
    "$PROXY_IMAGE" >/dev/null 2>&1
}

# Branches: running → reload config; absent → create (handling both a
# parallel-creation race and a busy host port); stopped → start.
_ensure_proxy() {
  local file="${CONFIG_DIR}/Caddyfile" tmp="${CONFIG_DIR}/Caddyfile.$$"
  # Truncate-write in place: the running proxy bind-mounts this exact inode,
  # so replacing the file (mv) would detach it. Per-PID temp file: parallel
  # aibox invocations each generate their own (identical) copy.
  _gen_caddyfile > "$tmp"
  if ! cmp -s "$tmp" "$file" 2>/dev/null; then
    cat "$tmp" > "$file"
  fi
  rm -f "$tmp"

  # A proxy stuck in Created never got past a failed docker run (busy port);
  # docker start cannot fix it, so remove it and let the create path retry.
  [[ "$(_state "$PROXY")" == "created" ]] && { docker rm -f "$PROXY" >/dev/null 2>&1 || true; } || true
  # The host port is baked into the container at creation, so a changed
  # proxy_port means recreating it. The 80→8080 fallback is left alone —
  # otherwise every run would retry 80 and fall back again.
  local cur
  cur="$(docker inspect "$PROXY" --format '{{(index (index .HostConfig.PortBindings "80/tcp") 0).HostPort}}' 2>/dev/null || true)"
  if [[ -n "$cur" && "$cur" != "$PROXY_PORT" && ! ( "$PROXY_PORT" == "80" && "$cur" == "8080" ) ]]; then
    _info "proxy_port changed (${cur} → ${PROXY_PORT}) — recreating the dev-server proxy."
    docker rm -f "$PROXY" >/dev/null 2>&1 || true
  fi

  case "$(_state "$PROXY")" in
    running)
      docker exec "$PROXY" caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1 \
        || docker restart "$PROXY" >/dev/null 2>&1 || true
      ;;
    absent)
      _info "Starting dev-server proxy (first run pulls a small Caddy image)..."
      if ! _start_proxy_on "$PROXY_PORT"; then
        # Two look-alike failures: a parallel invocation won the creation
        # race (its proxy reaches "running"; the name-conflict loser leaves
        # nothing), or the host port is busy (docker leaves a dead Created-
        # state container holding the name — must be removed before retry).
        sleep 1
        if [[ "$(_state "$PROXY")" != "running" ]]; then
          docker rm -f "$PROXY" >/dev/null 2>&1 || true
          if [[ "$PROXY_PORT" == "80" ]] && _start_proxy_on 8080; then
            _warn "Host port 80 unavailable — proxy on 8080 instead (URLs get :8080)."
          else
            # The failed fallback leaves its own Created wedge behind.
            [[ "$(_state "$PROXY")" == "created" ]] && { docker rm -f "$PROXY" >/dev/null 2>&1 || true; } || true
            local tried="port ${PROXY_PORT}"; [[ "$PROXY_PORT" == "80" ]] && tried="ports 80 and 8080"
            _warn "Dev-server proxy failed to start on ${tried}; containers still work (no dev URLs until it does)."
          fi
        fi
      fi
      ;;
    *)
      docker start "$PROXY" >/dev/null 2>&1 || true   # caddy re-reads the config on start
      ;;
  esac
}

# ── Container ────────────────────────────────────────────────────
CREATED=false   # set by _ensure_container, read by _ensure_all's first-run banner

_ensure_net_vol() {
  docker network create "$NETWORK" >/dev/null 2>&1 || true
  docker volume create "$VOLUME" >/dev/null 2>&1 || true
}

# Shared run-spec for project containers. Per-mode flags (restart policy,
# bind mount, labels) come as args and land before "$IMAGE" — docker flag
# order before the image is irrelevant.
#
# The home volume is mounted in slices (volume-subpath, Engine 26+): a
# private per-project home, with the shared Claude login/settings, binary,
# and this project's own transcripts mounted over it at their normal paths.
# Other projects' homes and transcripts are simply not mounted — that is the
# isolation boundary (in-volume permissions are meaningless with full sudo).
# todos/file-history/shell-snapshots stay inside the shared .claude mount.
_docker_run() {
  # Scheduling proposals: the one host path a container may write, its own
  # per-project inbox (see cmd_schedule). The .path file beside it tells the
  # scheduler which project a proposal came from — the mount is the sender.
  mkdir -p "${CONFIG_DIR}/inbox/${HASH6}"
  printf %s "$PROJECT_DIR" > "${CONFIG_DIR}/inbox/${HASH6}.path"
  # Host-to-container notices (today: the GPU browser URL) live in one
  # read-only mount shared by every container; nothing is copied into the
  # writable inbox, so a container can neither forge nor redirect them.
  mkdir -p "${CONFIG_DIR}/host"
  docker run -d --name "$CONTAINER" \
    --network "$NETWORK" \
    --hostname "${SLUG:0:63}" \
    --init \
    --add-host host.docker.internal:host-gateway \
    --mount "type=volume,src=${VOLUME},dst=/home/aibox,volume-subpath=projects/${HASH6}/home" \
    --mount "type=volume,src=${VOLUME},dst=/home/aibox/.claude,volume-subpath=shared/claude-cfg" \
    --mount "type=volume,src=${VOLUME},dst=/home/aibox/.claude/projects,volume-subpath=projects/${HASH6}/claude-projects" \
    --mount "type=volume,src=${VOLUME},dst=/home/aibox/.local/bin,volume-subpath=shared/local-bin" \
    --mount "type=volume,src=${VOLUME},dst=/home/aibox/.local/share/claude,volume-subpath=shared/claude-app" \
    -v "${CONFIG_DIR}/inbox/${HASH6}:/home/aibox/.aibox/proposals" \
    -v "${CONFIG_DIR}/host:/home/aibox/.aibox/host:ro" \
    -w "$PROJECT_DIR" \
    -e CLAUDE_CONFIG_DIR=/home/aibox/.claude \
    -l "aibox.path=${PROJECT_DIR}" \
    -l "aibox.layout=4" \
    "$@" "$IMAGE"
}

# Poll until $CONTAINER runs (kicking a stopped one); die with $1 after 5s.
_wait_running() {
  local i=0
  until [[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null)" == "true" ]]; do
    (( i++ >= 25 )) && _die "$1"
    docker start "$CONTAINER" >/dev/null 2>&1 || true
    sleep 0.2
  done
}

# ── Volume layout (v2: per-project isolation) ────────────────────
# aibox-home layout: shared/{claude-cfg,local-bin,claude-app} for the Claude
# login/settings and binary, projects/<hash6>/{home,claude-projects} per
# project. Marker file .aibox-layout at the volume root says the shape is
# current; a volume with old flat data and no marker is migrated in place
# (safety backup first). Unrecognized files are never moved or deleted.

# The migration body. AIBOX_MIG_ROOT lets it run against a plain directory
# instead of the mounted volume, for testing outside docker.
# POSIX sh — it runs under busybox in the helper image. $1 = hash6 of the
# project being started, so its slice exists even if it's new.
# Everything is driven by the absolute-path keys in .claude.json: the
# transcript dir names are lossy encodings (all punctuation → "-"), so the
# real paths are the only way to compute each project's hash.
_MIGRATE_SH='
set -e
cd "${AIBOX_MIG_ROOT:-/v}"
[ -f .aibox-layout ] && exit 0
mkdir -p shared/claude-cfg projects
# Never clobber: a half-migrated volume (crash, Ctrl-C, then refilled by
# migrate-to-v2.sh) can hold entries in both places, and the ones already
# in shared/ are the live copies.
if [ -d .claude ]; then
  for f in .claude/* .claude/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    b="$(basename "$f")"
    [ "$b" = projects ] && continue
    [ -e "shared/claude-cfg/$b" ] || [ -L "shared/claude-cfg/$b" ] || mv "$f" shared/claude-cfg/
  done
fi
if [ -d .local/bin ] && [ ! -e shared/local-bin ]; then mv .local/bin shared/local-bin; fi
if [ -d .local/share/claude ] && [ ! -e shared/claude-app ]; then mv .local/share/claude shared/claude-app; fi
mkdir -p shared/local-bin shared/claude-app
# copy_home <hash6>: seed a project home from the old root dotfiles.
# Copies are staged then renamed, so a crash mid-copy leaves only a temp
# dir that the re-run redoes — never a half .ssh that looks complete.
copy_home() {
  mkdir -p "projects/$1/home" "projects/$1/claude-projects"
  for d in .ssh .config .gitconfig .zshrc .zsh_history .zshenv .zprofile .netrc; do
    [ -e "$d" ] || continue
    [ -e "projects/$1/home/$d" ] && continue
    rm -rf "projects/$1/home/.aibox-mig-tmp"
    cp -a "$d" "projects/$1/home/.aibox-mig-tmp"
    mv "projects/$1/home/.aibox-mig-tmp" "projects/$1/home/$d"
  done
}
# Transcript-dir encoding exactly as Claude Code does it (per code point).
# The helper runs in the aibox image, so node is there; the sed fallback
# is byte-wise and only right for ASCII paths.
encode() {
  if command -v node >/dev/null 2>&1; then node -e "process.stdout.write(process.argv[1].replace(/[^a-zA-Z0-9]/g, \"-\"))" "$1"
  else printf %s "$1" | sed "s/[^A-Za-z0-9]/-/g"; fi
}
TAB="$(printf "\t")"
# KEYS: "enc<TAB>hash6<TAB>path" per project KEY of .claude.json, longest
# encoding first (the prefix pass below must try the most specific key
# first). Value-position path strings (MCP args, history entries) must
# never claim a transcript dir. IFS= keeps a trailing space in a path.
KEYS=""
CJ=shared/claude-cfg/.claude.json
if [ -f "$CJ" ]; then
  KEYS="$(grep -o "\"/[^\"]*\":" "$CJ" | sed "s/\":\$//; s/^\"//" | sort -u | while IFS= read -r p; do
    enc="$(encode "$p")"
    printf "%08d\t%s\t%s\t%s\n" "${#enc}" "$enc" "$(printf %s "$p" | sha256sum | cut -c1-6)" "$p"
  done | sort -rn | cut -f2-)"
fi
# (Loop bodies below end in if/case so a no-match last iteration cannot
# return non-zero and trip set -e.)
printf "%s\n" "$KEYS" | while IFS="$TAB" read -r enc h p; do
  if [ -n "$h" ]; then
    copy_home "$h"
    # The slice sentinel: the sessions page lists a slice only through it,
    # and container creation checks it for hash collisions.
    [ -e "projects/$h/.aibox-path" ] || printf %s "$p" > "projects/$h/.aibox-path"
  fi
done
copy_home "$1"
# claim <dir name> → hash6 of the owning key, or empty. Exact encoding
# first, else the longest key whose encoding is a prefix: sessions started
# in a subdirectory of a project, which in v2 land in the parent slice
# anyway. The encoding is lossy, so a prefix claim can pick a sibling
# project; nothing is deleted, the sessions page shows the dir under the
# claimed project, and --resume finds a session by id from any directory.
claim() {
  r="$(printf "%s\n" "$KEYS" | while IFS="$TAB" read -r enc h p; do
    if [ -n "$enc" ] && [ "$1" = "$enc" ]; then echo "$h"; exit 0; fi
  done)"
  [ -n "$r" ] || r="$(printf "%s\n" "$KEYS" | while IFS="$TAB" read -r enc h p; do
    if [ -n "$enc" ]; then case "$1" in "$enc"-*) echo "$h"; exit 0;; esac; fi
  done)"
  printf %s "$r"
}
if [ -d .claude/projects ]; then
  for d in .claude/projects/*; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    h="$(claim "$name")"
    [ -n "$h" ] || continue
    [ -e "projects/$h/claude-projects/$name" ] || mv "$d" "projects/$h/claude-projects/$name"
  done
fi
# Anything still unclaimed (no key, no matching prefix) stays put — but say
# so loudly. Finder litter is not worth a warning.
if [ -d .claude/projects ] && [ -n "$(ls -A .claude/projects 2>/dev/null | grep -v "^\.DS_Store\$")" ]; then
  echo "aibox migrate: transcript dirs left unclaimed (kept in the volume at .claude/projects/):" >&2
  ls -A .claude/projects >&2
fi
chown -R 1000:1000 shared projects 2>/dev/null || true
echo 2 > .aibox-layout
'

_migrate_layout() {
  # Anything with the volume mounted (labels or not — the oldest containers
  # carry none) would race the file moves under a live claude.
  local running
  running="$(docker ps -q --filter "volume=${VOLUME}" | head -1)"
  [[ -n "$running" ]] && _die "The home volume needs a one-time migration to the per-project layout, but containers are still using it. Exit sessions, run: aibox stop --all, then retry."
  # Serialize concurrent invocations. The steal threshold must exceed the
  # safety backup of a large volume (minutes), so it is deliberately huge;
  # a genuinely stale lock (Ctrl-C at the wrong moment) gets a hint instead.
  local lock="${CONFIG_DIR}/.lock-migrate" waited=0
  until mkdir "$lock" 2>/dev/null; do
    (( waited % 600 == 599 )) && _info "Waiting for another aibox migration to finish... (if none is running, remove the stale lock: rmdir ${lock})"
    (( waited++ >= 36000 )) && { _unlock "$lock"; waited=0; }   # 1h
    sleep 0.1
  done
  LOCKS+=("$lock"); _on_exit _unlock_all
  # Another invocation may have finished the migration while we waited.
  if [[ "$(docker run --rm -v "${VOLUME}:/v" "$HELPER_IMAGE" sh -c '[ -f /v/.aibox-layout ] && echo done || true')" == "done" ]]; then
    _unlock "$lock"
    return 0
  fi
  _info "Migrating ${VOLUME} to the per-project layout (one-time; old files stay in the volume untouched)..."
  local safety
  safety="$(_do_backup "$BACKUP_DIR" "aibox-home-pre-migrate")" \
    || { _unlock "$lock"; _die "Safety backup failed — migration aborted, the volume is untouched."; }
  _ok "Safety backup: ${safety}"
  # Runs in the aibox image (present by now), not the alpine helper: the
  # migration needs node to encode transcript-dir names exactly as Claude
  # Code does.
  if ! printf '%s' "$_MIGRATE_SH" | docker run -i --rm --entrypoint sh -v "${VOLUME}:/v" "$IMAGE" -s "$HASH6"; then
    _unlock "$lock"
    _die "Migration failed — restore the safety backup above with: aibox restore <file>"
  fi
  _unlock "$lock"
  _ok "Migrated. Each project now has a private home; login, settings, and the claude binary stay shared."
}

# Detect the volume's shape, create/migrate as needed, and make sure this
# project's slices exist. Called right before every container create.
_ensure_layout() {
  local ver maj
  ver="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"
  maj="${ver%%.*}"
  if [[ "$maj" =~ ^[0-9]+$ ]] && (( maj < 26 )); then
    _die "aibox needs Docker Engine 26+ (volume subpath mounts); found ${ver}. Update your runtime (brew upgrade colima / update OrbStack or Docker Desktop)."
  fi
  # Fresh means EMPTY: any other marker-less content (even just an .ssh dir
  # from an odd v1 life) goes through migration, which backs up first and
  # only moves what it recognizes. Detection failing (offline first pull,
  # daemon hiccup) must fail closed — creating containers against wrong
  # slices produces far worse errors than stopping here.
  local state
  state="$(docker run --rm -v "${VOLUME}:/v" "$HELPER_IMAGE" sh -c '
    set -e
    if [ -f /v/.aibox-layout ]; then echo current
    elif [ -z "$(ls -A /v 2>/dev/null)" ]; then
      mkdir -p /v/shared/claude-cfg /v/shared/local-bin /v/shared/claude-app /v/projects
      echo 2 > /v/.aibox-layout
      echo current
    else echo legacy
    fi' | tail -1)"
  case "$state" in
    current) ;;
    legacy)  _migrate_layout ;;
    *)       _die "Could not inspect the ${VOLUME} volume layout (docker error above). Retry once docker/network is healthy." ;;
  esac
  # This project's slices. The .aibox-path sentinel catches the (rare)
  # 6-hex-digit path-hash collision between two projects, which would
  # otherwise silently merge their private homes.
  local slice
  slice="$(docker run --rm -e "P=${PROJECT_DIR}" -v "${VOLUME}:/v" "$HELPER_IMAGE" sh -c '
    set -e
    d="/v/projects/'"${HASH6}"'"
    # Shared dirs too: docker does not create a missing volume-subpath, so a
    # volume whose shared/ went missing would otherwise fail every create.
    mkdir -p /v/shared/claude-cfg /v/shared/local-bin /v/shared/claude-app "$d/home" "$d/claude-projects"
    if [ -f "$d/.aibox-path" ]; then
      [ "$(cat "$d/.aibox-path")" = "$P" ] || { echo COLLISION; exit 0; }
    else printf %s "$P" > "$d/.aibox-path"; fi
    chown -R 1000:1000 "$d"
    echo OK' | tail -1)"
  case "$slice" in
    OK) ;;
    COLLISION) _die "Path-hash collision: another project already owns slice projects/${HASH6}. Rename this project directory to resolve it." ;;
    *)  _die "Could not prepare the volume slices for ${SLUG} (docker error above)." ;;
  esac
}

_ensure_container() {
  _ensure_net_vol

  # Serialize create/recreate across concurrent invocations (mkdir is
  # atomic): without this, two new-version invocations could both decide to
  # recreate and the second would rm the first's fresh container. A lock
  # older than ~15s is presumed dead and stolen.
  local lock="${CONFIG_DIR}/.lock-${CONTAINER}" waited=0
  until mkdir "$lock" 2>/dev/null; do
    (( waited++ >= 150 )) && { _unlock "$lock"; waited=0; }
    sleep 0.1
  done
  LOCKS+=("$lock"); _on_exit _unlock_all

  # A GPU browser server that ended without its cleanup (reboot, kill -9)
  # leaves its URL advertised; withdraw it so sessions ask for a new one.
  [[ -f "${CONFIG_DIR}/host/browser.url" ]] && ! pgrep -u "$RENDER_USER" -f 'node serve.js' >/dev/null 2>&1 \
    && rm -f "${CONFIG_DIR}/host/browser.url" || true

  local state cur_img cur_layout
  read -r state cur_img cur_layout < <(docker inspect "$CONTAINER" \
    --format '{{.State.Status}} {{.Config.Image}} {{index .Config.Labels "aibox.layout"}}' 2>/dev/null) || true
  state="${state:-absent}"

  # Recreate when the image changed (new aibox version or node_version), the
  # container predates the current volume layout (its mounts are stale), or
  # it never got past Created (a failed docker run leaves the name wedged —
  # docker start can never succeed, and there are no processes to protect).
  # The home volume and project bind survive by construction.
  if [[ "$state" != "absent" && -n "${cur_img:-}" && ( "$cur_img" != "$IMAGE" || "${cur_layout:-}" != "4" || "$state" == "created" ) ]]; then
    local active=0
    if [[ "$state" == "running" ]]; then
      active="$(docker top "$CONTAINER" -o pid,args 2>/dev/null | tail -n +2 | grep -vc 'sleep infinity' || true)"
      active="${active//[^0-9]/}"   # arithmetic-safe
    fi
    if [[ "${active:-0}" -gt 0 ]]; then
      _warn "Container needs recreating (image or layout updated) but ${active} process(es) still running in the old one — keeping it for now. To update: exit sessions / stop dev servers, then run: aibox stop && aibox"
    else
      _info "Recreating container (image or layout updated) — sessions/login/project files persist; apt-installed packages reset (use ~/.aibox/Dockerfile.extra to keep them)."
      docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
      state=absent
    fi
  fi

  if [[ "$state" == "absent" ]]; then
    _require_safe_dir
    _ensure_layout
    local run_err=""
    # 2>&1 >/dev/null captures stderr only (order matters) — shown by
    # _wait_running if the container never comes up.
    run_err="$(_docker_run \
      --restart unless-stopped \
      -v "${PROJECT_DIR}:${PROJECT_DIR}" \
      -l "aibox.slug=${SLUG}" \
      2>&1 >/dev/null)" || true   # || true: parallel tab may have created it
    CREATED=true
  elif [[ "$state" != "running" ]]; then
    docker start "$CONTAINER" >/dev/null 2>&1 || true
  fi

  _unlock "$lock"

  _wait_running "Container failed to start.${run_err:+ ${run_err}}"
  _run_on_start
}

# `on-start` schedule entries for this project: re-launch long-running
# things (dev servers, a headless browser, remote-control sessions) once per
# container boot. The entrypoint clears /tmp/aibox-onstart-done at every
# start (dockerd restarts containers itself after a reboot, before aibox
# looks), so the marker, not aibox's own start path, decides. Called on
# every aibox run and by the scheduler tick (onstart-check).
_run_on_start() {
  [[ -f "${CONFIG_DIR}/schedule.json" ]] || return 0
  local first
  first="$(docker exec -u aibox "$CONTAINER" sh -c '[ -e /tmp/aibox-onstart-done ] || { touch /tmp/aibox-onstart-done && echo RUN; }' 2>/dev/null || true)"
  [[ "$first" == "RUN" ]] || return 0
  _write_schedule_js
  local c
  AIBOX_CFG="$CONFIG_DIR" node "${CONFIG_DIR}/schedule.js" on-start "$PROJECT_DIR" 2>/dev/null | while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    _info "on-start: ${c}"
    docker exec -d -u aibox -w "$PROJECT_DIR" "$CONTAINER" bash -lc "$c" || true
  done
  return 0
}

# Scheduler plumbing: run this project's on-start entries if its container
# is up and hasn't had them this boot. Never starts docker or containers.
cmd_onstart_check() {
  docker info >/dev/null 2>&1 || return 0
  [[ "$(_state "$CONTAINER")" == "running" ]] || return 0
  _run_on_start
}

_ensure_claude_bin() {
  # Wait (in-container, one exec) until the entrypoint's start-up work is
  # done — the marker appears even if its install attempt failed. The
  # binary test doubles as the exit path for containers from older images
  # that never write a marker. Up to 180s: the first install downloads the
  # binary.
  docker exec -u aibox "$CONTAINER" sh -c '
    i=0
    until [ -e /tmp/aibox-ready ] || [ -x "$HOME/.local/bin/claude" ]; do
      i=$((i+1)); [ "$i" -ge 180 ] && break
      [ "$i" -eq 3 ] && echo "Waiting for first-time container setup (claude install)..." >&2
      sleep 1
    done
    [ -x "$HOME/.local/bin/claude" ]' && return 0
  _info "Installing Claude Code into the shared home volume (one-time)..."
  docker exec -u aibox "$CONTAINER" bash -c 'curl -fsSL https://claude.ai/install.sh | bash' || true
  docker exec -u aibox "$CONTAINER" test -x /home/aibox/.local/bin/claude 2>/dev/null \
    || _die "Claude Code install failed — see the curl output above. Retry, or run: aibox shell 'curl -fsSL https://claude.ai/install.sh | bash'"
}

_ensure_all() {
  _ensure_docker
  _ensure_image
  _ensure_container
  _ensure_proxy   # after _ensure_container: the Caddyfile must include the new container
  if [[ "$CREATED" == "true" ]]; then
    _ok "Container ready. Dev servers: $(_dev_url)"
  fi
  _remind_proposals
}

# ── exec plumbing ────────────────────────────────────────────────
_dexec() {
  local tty_args=(-i)
  [[ -t 0 && -t 1 ]] && tty_args=(-it)
  local env_args=(
    -e "TERM=${TERM:-xterm-256color}"
    -e "COLORTERM=${COLORTERM:-truecolor}"
    -e "LANG=${LANG:-C.UTF-8}"
    -e "AIBOX_URL_BASE=$(_pub_label).aibox.localhost$(_proxy_suffix)"
  )
  # Forward exported ANTHROPIC_* vars (compgen, not `env` parsing — multiline
  # values in unrelated vars must not fabricate variable names).
  local var
  for var in $(compgen -A export | grep '^ANTHROPIC_' || true); do
    env_args+=(-e "${var}=${!var}")
  done
  docker exec "${tty_args[@]}" -u aibox -w "$PROJECT_DIR" "${env_args[@]}" "$CONTAINER" "$@"
}

# ── Disposable copy container (--copy) ───────────────────────────
# A fresh container per run on a snapshot of the project — no bind mount, so
# the real directory cannot be touched from inside. Shares the home volume
# (login, sessions, claude binary) and gets its own dev URLs under
# <slug>-copy. Removed when the session exits; work is kept by committing
# and pushing from inside before exiting.

_cleanup_copy() {
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  # Drop the copy's proxy route; only touch a proxy that is already running.
  [[ "$(_state "$PROXY")" == "running" ]] && _ensure_proxy >/dev/null 2>&1 || true
}

_ensure_copy_all() {
  _ensure_docker
  _ensure_image
  _require_safe_dir
  _ensure_net_vol
  _ensure_layout
  # Unique name per run: concurrent --copy sessions are separate sandboxes.
  # The trailing random segment doubles as the URL suffix if slugs collide
  # (see _proxy_pairs). No --restart policy: disposable by design.
  CONTAINER="${CONTAINER}-copy-$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  _on_exit _cleanup_copy
  _docker_run -l "aibox.slug=${SLUG}-copy" -l "aibox.copy=1" >/dev/null
  _wait_running "Copy container failed to start."
  _ensure_proxy   # independent of the snapshot — do it before the slow part
  _info "Snapshotting project into the container (the real ${PROJECT_DIR} is not mounted)..."
  # Stream the tree and extract as the container user, so files are born
  # owned by aibox — no second full-tree chown pass. Only the workdir itself
  # (auto-created root-owned by docker run -w) needs its owner fixed first.
  # COPYFILE_DISABLE stops macOS tar from adding AppleDouble ._* entries.
  docker exec -u root "$CONTAINER" chown aibox:aibox "$PROJECT_DIR"
  COPYFILE_DISABLE=1 tar -cf - -C "$PROJECT_DIR" . \
    | docker exec -i -u aibox "$CONTAINER" tar -xpf - -C "$PROJECT_DIR" \
    || _die "Project snapshot failed."
  _ok "Disposable copy ready — removed on exit; commit & push from inside to keep work. Dev servers: $(_dev_url)"
}

# ── Commands ─────────────────────────────────────────────────────
# Run any program in the sandbox. `aibox` / `aibox claude` is just
# `aibox run claude` (see dispatch). aibox's own flags (--copy, --yolo —
# semantics in the usage header) are consumed wherever they appear; the
# first `--` ends that, everything after it passes through verbatim.
cmd_run() {
  local copy=false yolo=false passthru=false args=() a
  for a in "$@"; do
    if [[ "$passthru" == "true" ]]; then args+=("$a"); continue; fi
    case "$a" in
      --copy) copy=true ;;
      --yolo) yolo=true ;;
      --)     passthru=true ;;
      *)      args+=("$a") ;;
    esac
  done
  [[ ${#args[@]} -ge 1 ]] || _die "Usage: aibox run [--copy] <program> [args...]"
  if [[ "$yolo" == "true" && "${args[0]}" != "claude" ]]; then
    _die "--yolo maps to claude's permission flags — pass ${args[0]}'s own approval flags as normal args."
  fi

  if [[ "$copy" == "true" ]]; then
    _ensure_copy_all
  else
    _ensure_all
  fi

  if [[ "${args[0]}" == "claude" ]]; then
    _ensure_claude_bin
    local perm_flag=--allow-dangerously-skip-permissions
    [[ "$yolo" == "true" ]] && perm_flag=--dangerously-skip-permissions
    set -- "${args[@]}"; shift   # program args without the leading "claude"
    _dexec claude "$perm_flag" "$@"
  else
    _dexec "${args[@]}"
  fi
}

cmd_shell() {
  _ensure_all
  if [[ $# -eq 0 ]]; then
    _dexec zsh
  elif [[ $# -eq 1 ]]; then
    _dexec zsh -lc "$1"                      # one arg = shell string: pipes/globs work
  else
    _dexec zsh -lc "$(printf '%q ' "$@")"    # several = safely-quoted argv
  fi
}

# ── Serve: phone/browser sessions (remote control) ───────────────
# One model: every live session — brand new or revived — is one detached
# `claude ... --remote-control` process in the project container, spawned
# from the sessions UI (port 45789, via the dev proxy) or by any Claude
# session (the shared CLAUDE.md teaches the command). No server mode and no
# resume windows: a dead process's conversation is just a transcript on
# disk, and Resume is the recovery. Registration is outbound HTTPS only.
# `aibox serve` runs the UI; `aibox serve stop` also kills every session.
cmd_serve() {
  if [[ "${1:-}" == "stop" ]]; then
    _ensure_docker
    if [[ "$(_state "$CONTAINER")" == "running" ]]; then
      # Each pkill as direct exec argv: a sh -c wrapper would carry the
      # pattern in its own cmdline and be pkill's first victim, aborting
      # the rest. pkill always excludes itself.
      docker exec -u aibox "$CONTAINER" pkill -f aibox-serve-ui >/dev/null 2>&1 || true
      docker exec -u aibox "$CONTAINER" pkill -f -- --remote-control >/dev/null 2>&1 || true
      _ok "Stopped the sessions UI and all remote-control sessions for ${SLUG}."
    else
      _info "Not running: ${SLUG}"
    fi
    return 0
  fi
  [[ $# -eq 0 ]] || _die "Usage: aibox serve [stop]"

  _ensure_all
  _ensure_claude_bin

  # Sessions UI (idempotent: rewrite the file, start only if not running).
  docker exec -i -u aibox "$CONTAINER" sh -c 'mkdir -p "$HOME/.aibox-serve" && cat > "$HOME/.aibox-serve/ui.js"' <<'UIJS'
// aibox sessions UI — generated by aibox (rewritten on every `aibox serve`).
// Lists this project's transcripts; a click revives one as a remote session.
const http = require("http"), fs = require("fs"), path = require("path"), cp = require("child_process");
const PORT = 45789;
const HOME = process.env.HOME || "/home/aibox";
const DIR = path.join(HOME, ".claude", "projects", process.cwd().replace(/[^A-Za-z0-9]/g, "-"));
const esc = s => s.replace(/[&<>]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
const PROJECT = esc(path.basename(process.cwd()));

function firstUserText(file) {
  try {
    const fd = fs.openSync(file, "r"), buf = Buffer.alloc(262144);
    const n = fs.readSync(fd, buf, 0, buf.length, 0);
    fs.closeSync(fd);
    for (const line of buf.slice(0, n).toString("utf8").split("\n")) {
      if (!line.trim()) continue;
      let j; try { j = JSON.parse(line); } catch (e) { continue; }
      if (j.type === "user" && j.message && !j.isMeta) {
        const c = j.message.content;
        let t = typeof c === "string" ? c : Array.isArray(c) ? c.map(x => x.text || "").join(" ") : "";
        t = t.replace(/\s+/g, " ").trim();
        if (!t || t.startsWith("Caveat:") || t.startsWith("<command-")) continue;
        return t.slice(0, 90);
      }
    }
  } catch (e) {}
  return "Untitled session";
}
// Conversation turns only (transcripts also carry tool results and other
// bookkeeping lines); cached by size+mtime — transcripts can be many MB and
// this runs on every poll.
const countCache = {};
function messageCount(file, st) {
  const c = countCache[file];
  if (c && c.size === st.size && c.mtimeMs === st.mtimeMs) return c.n;
  let n = 0;
  try {
    for (const l of fs.readFileSync(file, "utf8").split("\n"))
      if (l.includes("\"type\":\"user\"") || l.includes("\"type\":\"assistant\"")) n++;
  } catch (e) { return 0; }
  countCache[file] = { size: st.size, mtimeMs: st.mtimeMs, n: n };
  return n;
}
function liveIds(cb) {
  cp.exec("pgrep -fa -- --remote-control || true", (e, out) => {
    const ids = new Set();
    String(out || "").split("\n").forEach(l => {
      const m = l.match(/(?:--resume|--session-id)[= ]([0-9a-f-]{36})/);
      if (m) ids.add(m[1]);
    });
    cb(ids);
  });
}
function sessions(cb) {
  let files = [];
  try { files = fs.readdirSync(DIR).filter(f => f.endsWith(".jsonl")); } catch (e) {}
  liveIds(live => {
    const list = [];
    files.forEach(f => {
      // Per-file guard: a transcript can vanish between readdir and stat
      // (Claude Code cleanup, manual rm) — that must not kill the server.
      try {
        const p = path.join(DIR, f), st = fs.statSync(p), id = f.slice(0, -6);
        list.push({ id, mtime: st.mtimeMs, title: firstUserText(p), messages: messageCount(p, st), live: live.has(id) });
      } catch (e) {}
    });
    list.sort((a, b) => b.mtime - a.mtime);
    // Live processes whose transcript has not appeared yet (a session
    // spawned moments ago) still deserve a row.
    const known = new Set(list.map(s => s.id));
    live.forEach(id => {
      if (!known.has(id)) list.unshift({ id, mtime: Date.now(), title: "New session — say something to it", messages: 0, live: true });
    });
    cb(list);
  });
}
