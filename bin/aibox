function spawnSession(args) {
  const c = cp.spawn("script", ["-qfc", "claude " + args + " --remote-control", "/dev/null"],
    { detached: true, stdio: "ignore", cwd: process.cwd() });
  c.on("error", function () {});
  c.unref();
}
http.createServer((req, res) => {
  let u;
  // Request-targets like "//" make new URL() throw — a crash here would
  // kill the whole UI.
  try { u = new URL(req.url, "http://x"); } catch (e) { res.writeHead(400); return res.end("bad request"); }
  // *.aibox.localhost is loopback in the browser, so any web page could POST
  // here through the proxy; only this page's own origin may. (The proxy
  // passes Host through unchanged, so Origin equals "http://" + Host.)
  if (req.method === "POST" && (req.headers.origin || "") !== "http://" + (req.headers.host || "")) {
    res.writeHead(403); return res.end("forbidden");
  }
  if (req.method === "POST" && u.pathname === "/api/new") {
    const id = require("crypto").randomUUID();
    spawnSession("--session-id " + id);
    res.writeHead(200, { "content-type": "application/json" });
    return res.end(JSON.stringify({ ok: true, id: id }));
  }
  if (req.method === "POST" && u.pathname === "/api/stop") {
    const id = String(u.searchParams.get("id") || "");
    if (!/^[0-9a-f-]{36}$/.test(id)) { res.writeHead(400); return res.end("bad id"); }
    // id is regex-vetted above, so interpolating it into the shell is safe
    cp.exec("pkill -f -- \"(--resume|--session-id)[= ]" + id + "\" || true", () => {
      res.writeHead(200, { "content-type": "application/json" });
      res.end("{\"ok\":true}");
    });
    return;
  }
  if (req.method === "POST" && u.pathname === "/api/resume") {
    const id = String(u.searchParams.get("id") || "");
    if (!/^[0-9a-f-]{36}$/.test(id)) { res.writeHead(400); return res.end("bad id"); }
    return liveIds(live => {
      // Double-resume would attach two claude processes to one transcript
      // (clients on several devices share this page).
      if (live.has(id)) { res.writeHead(409); return res.end("already live"); }
      spawnSession("--resume " + id);
      res.writeHead(200, { "content-type": "application/json" });
      res.end("{\"ok\":true}");
    });
  }
  if (u.pathname === "/api/sessions") {
    return sessions(list => {
      res.writeHead(200, { "content-type": "application/json" });
      res.end(JSON.stringify(list));
    });
  }
  res.writeHead(200, { "content-type": "text/html; charset=utf-8" });
  res.end(PAGE);
  // Container-wide bind is what lets the dev proxy reach us; the accepted
  // trade-off is that other containers on the aibox network can reach it
  // too. Endpoints only spawn/stop sessions of THIS project.
}).listen(PORT, "0.0.0.0");
UIJS
  if ! docker exec -u aibox "$CONTAINER" pgrep -f aibox-serve-ui >/dev/null 2>&1; then
    # The tag rides as an (ignored) node argv so it survives exec and is
    # visible to pgrep/pkill — a comment in bash -c would be erased by exec.
    docker exec -d -u aibox -w "$PROJECT_DIR" "$CONTAINER" bash -c \
      'exec node "$HOME/.aibox-serve/ui.js" aibox-serve-ui >>"$HOME/.aibox-serve/ui.log" 2>&1'
  fi

  _ok "Sessions UI: $(_dev_url 45789) — new session, resume, live list."
  _info "Sessions started there register with claude.ai (Claude app included) and keep running after this terminal closes. End everything with: aibox serve stop"
}

# Plumbing for the host-side sessions page (and handy on its own): make one
# past session of THIS project drivable from claude.ai / the Claude app.
cmd_rc_resume() {
  [[ "${1:-}" =~ ^[0-9a-f-]{36}$ ]] || _die "Usage: aibox rc-resume <session-id>"
  _ensure_all
  _ensure_claude_bin
  docker exec -d -u aibox -w "$PROJECT_DIR" "$CONTAINER" \
    script -qfc "claude --resume $1 --remote-control" /dev/null
  _ok "Session registering — it appears in the claude.ai / Claude app list shortly."
}

# ── Schedule (host-side jobs that run inside project sandboxes) ──
# One launchd agent (macOS) / crontab line (Linux) runs `aibox schedule
# tick` every minute. Entries live in ~/.aibox/schedule.json on the HOST;
# each runs as `aibox shell <cmd>` in its project, so nothing in the
# registry can execute outside a container. Containers can only write
# proposals into their own inbox mount, which the tick surfaces for
# approval. The logic is Node (date math is the same on macOS and Linux).
_write_schedule_js() {
  cat > "${CONFIG_DIR}/schedule.js" <<'SCHEDJS'
// aibox schedule — host-side scheduler. Generated by aibox (rewritten on
// every `aibox schedule` run). One launchd agent (macOS) or crontab line
// (Linux) runs `aibox schedule tick` every minute; the tick starts due
// jobs, each as `aibox shell '<cmd>'` in its project, re-launches on-start
// entries after a container (re)boot, and surfaces pending proposals from
// containers. Registry and state live in ~/.aibox; the only thing a
// container can write is its own inbox of proposals.
const fs = require("fs"), path = require("path"), cp = require("child_process"), os = require("os"), crypto = require("crypto");
const CFG = process.env.AIBOX_CFG || "", AIBOX = process.env.AIBOX_BIN || "aibox";
const REG = path.join(CFG, "schedule.json"), STATE_DIR = path.join(CFG, "schedule-state"), SNOOZE = path.join(CFG, "schedule-snooze.json");
const LOG = path.join(CFG, "schedule.log"), INBOX = path.join(CFG, "inbox");
const MAC = process.platform === "darwin";
const NAME_RE = /^[a-z0-9][a-z0-9-]{0,31}$/, MAX_PROPOSAL = 2048, MAX_PREVIEW = 4096;
const now = () => process.env.AIBOX_NOW ? new Date(Number(process.env.AIBOX_NOW)) : new Date();
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch (e) { return d; } };
// Per-process temp name: several processes (tick + run children) write
// state at once, and a shared temp name loses writes.
function writeJson(f, o) { const t = f + "." + process.pid + ".tmp"; fs.writeFileSync(t, JSON.stringify(o, null, 2) + "\n"); fs.renameSync(t, f); }
const shq = s => "'" + String(s).replace(/'/g, "'\\''") + "'";
const log = line => fs.appendFileSync(LOG, now().toISOString() + " " + line + "\n");
const die = msg => { console.error("✗ " + msg); process.exit(1); };
// Bounded read of a REGULAR file only: inbox files and prompt files are
// written inside containers, so a FIFO, a symlink to /dev/zero, a
// directory, or a huge file must not hang or crash the tick.
function safeRead(file, max) {
  let fd = null;
  try {
    if (!fs.lstatSync(file).isFile()) return null;
    fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
    const st = fs.fstatSync(fd); if (!st.isFile() || st.size > max) return null;
    const buf = Buffer.alloc(max), n = fs.readSync(fd, buf, 0, max, 0);
    return buf.slice(0, n).toString("utf8");
  } catch (e) { return null; } finally { if (fd !== null) fs.closeSync(fd); }
}

// ── schedule forms ──────────────────────────────────────────────
// daily HH:MM · weekdays HH:MM · every Nm|Nh (5m…24h, counted from local
// midnight) · on-start
function parseWhen(s) {
  s = String(s || "").trim().toLowerCase(); let m;
  if (s === "on-start") return { kind: "on-start", text: s };
  if ((m = s.match(/^(daily|weekdays) ([01]?\d|2[0-3]):([0-5]\d)$/)))
    return { kind: m[1], h: +m[2], min: +m[3], text: m[1] + " " + String(+m[2]).padStart(2, "0") + ":" + m[3] };
  if ((m = s.match(/^every (\d{1,3})(m|h)$/))) {
    const n = +m[1] * (m[2] === "h" ? 60 : 1);
    if (n >= 5 && n <= 1440) return { kind: "every", minutes: n, text: s };
  }
  return null;
}
// Latest due time at or before t (local time); null if none / on-start.
function lastDue(w, t) {
  if (w.kind === "every") {
    const d = new Date(t), slot = Math.floor((t.getHours() * 60 + t.getMinutes()) / w.minutes) * w.minutes;
    d.setHours(0, slot, 0, 0); return d;
  }
  if (w.kind !== "daily" && w.kind !== "weekdays") return null;
  for (let back = 0; back < 8; back++) {
    const d = new Date(t); d.setDate(d.getDate() - back); d.setHours(w.h, w.min, 0, 0);
    if (d > t) continue;
    if (w.kind === "weekdays" && (d.getDay() === 0 || d.getDay() === 6)) continue;
    return d;
  }
  return null;
}
function nextDue(w, t) {
  if (w.kind === "every") {
    const d = new Date(t), slot = (Math.floor((t.getHours() * 60 + t.getMinutes()) / w.minutes) + 1) * w.minutes;
    d.setHours(0, slot, 0, 0); return d;
  }
  if (w.kind !== "daily" && w.kind !== "weekdays") return null;
  for (let fwd = 0; fwd < 8; fwd++) {
    const d = new Date(t); d.setDate(d.getDate() + fwd); d.setHours(w.h, w.min, 0, 0);
    if (d <= t) continue;
    if (w.kind === "weekdays" && (d.getDay() === 0 || d.getDay() === 6)) continue;
    return d;
  }
  return null;
}
const fmt = d => d ? d.toLocaleString(undefined, { weekday: "short", hour: "2-digit", minute: "2-digit", month: "short", day: "numeric" }) : "–";

// ── entries ─────────────────────────────────────────────────────
// kind "claude": a prompt file runs as a fresh headless session with a
// fixed, reviewable flag set (prompt on stdin, so a file starting with
// "---" is not parsed as an option). kind "run": one shell line.
function containerCmd(e) {
  if (e.kind === "claude") return "claude -p --permission-mode auto --permission-prompts none --max-turns 30 < " + shq(e.arg);
  return e.arg;
}
function validate(e) {
  if (!NAME_RE.test(e.name || "")) return "name must be 1–32 chars of a-z, 0-9, dashes";
  const w = parseWhen(e.when); if (!w) return "when must be: daily HH:MM · weekdays HH:MM · every 30m / every 2h · on-start";
  if (!e.project || !path.isAbsolute(e.project) || !fs.existsSync(e.project)) return "project directory not found: " + e.project;
  if (e.kind === "claude") {
    if (!e.arg || e.arg.split(/[\\/]/).includes("..") || path.isAbsolute(e.arg)) return "claude needs a prompt file path relative to the project";
    if (safeRead(path.join(e.project, e.arg), MAX_PREVIEW) === null) return "prompt file missing or not a small regular file: " + e.arg;
    if (w.kind === "on-start") return "an on-start entry must be a run command";
  } else if (e.kind === "run") {
    if (!e.arg || e.arg.length > 200 || /[\r\n]/.test(e.arg)) return "run command must be 1–200 chars on one line (put longer ones in a script)";
  } else return "kind must be claude or run";
  return null;
}
const entries = () => readJson(REG, []);
const getState = name => readJson(path.join(STATE_DIR, name + ".json"), {});
function setState(name, patch) { fs.mkdirSync(STATE_DIR, { recursive: true }); const f = path.join(STATE_DIR, name + ".json"); writeJson(f, Object.assign(readJson(f, {}), patch)); }
function addEntry(e, source) {
  const err = validate(e); if (err) die(err);
  const all = entries(), clash = all.find(x => x.name === e.name && x.project !== e.project);
  if (clash) die("the name " + e.name + " is already used by " + clash.project + " — remove it (aibox schedule rm " + e.name + ") or pick another name");
  const list = all.filter(x => x.name !== e.name);   // same project + same name: replace
  list.push({ name: e.name, when: parseWhen(e.when).text, project: e.project, kind: e.kind, arg: e.arg, added: now().toISOString() });
  writeJson(REG, list);
  setState(e.name, { last: now().getTime() });   // waits for the NEXT occurrence
  log("added " + e.name + " (" + source + "): " + e.when + " · " + e.kind + " " + e.arg + " · " + e.project);
  if (!installed()) install();
}

// ── proposals (from containers, via the per-project inbox mount) ────
// File <inbox>/<hash6>/<name>: line 1 = when, line 2 = "claude <file>" or
// "run <command>". <hash6>.path (written by aibox on the host) names the
// project — the sender is the mount, never a field in the file. Invalid
// ones are never deleted automatically (Claude may still be writing the
// prompt file); they show as INVALID until rejected.
function proposals() {
  const out = [];
  let dirs = []; try { dirs = fs.readdirSync(INBOX).filter(d => !d.startsWith(".") && !d.endsWith(".path")); } catch (e) {}
  for (const h of dirs) {
    let project = ""; try { project = fs.readFileSync(path.join(INBOX, h + ".path"), "utf8").trim(); } catch (e) {}
    let files = []; try { files = fs.readdirSync(path.join(INBOX, h)).filter(f => !f.startsWith(".")); } catch (e) {}
    for (const f of files) {
      const file = path.join(INBOX, h, f), p = { id: h + "/" + f, name: f, project, file, error: null, when: "", kind: "", arg: "", hash: "" };
      try {
        const text = safeRead(file, MAX_PROPOSAL);
        if (text === null) { p.error = "not a small regular file"; }
        else {
          p.hash = crypto.createHash("sha256").update(text).digest("hex").slice(0, 16);
          const lines = text.split("\n").map(s => s.trim()).filter(Boolean);
          p.when = lines[0] || ""; const m = (lines[1] || "").match(/^(claude|run)\s+(.+)$/); if (m) { p.kind = m[1]; p.arg = m[2]; }
          p.error = validate(p);
        }
      } catch (e) { p.error = "unreadable"; }
      out.push(p);
    }
  }
  return out;
}
// A bare name is enough unless two projects proposed the same name.
function findProposal(ref) {
  const all = proposals(), hits = all.filter(p => p.id === ref || p.name === ref);
  if (!hits.length) die("no proposal named " + ref + " (aibox schedule lists them)");
  if (hits.length > 1) die("several projects proposed " + ref + " — use one of: " + hits.map(p => p.id).join(", "));
  return hits[0];
}
function describe(p) {
  const proj = path.basename(p.project || "?");
  let what = p.kind === "claude" ? "Claude runs the prompt file " + p.arg : "runs: " + p.arg;
  if (p.kind === "claude" && !p.error) {
    const t = safeRead(path.join(p.project, p.arg), MAX_PREVIEW);
    if (t) what += "\n\n" + t.split("\n").slice(0, 10).join("\n").slice(0, 600);
  }
  return "Project " + proj + " proposes “" + p.name + "”: " + p.when + "\n" + what + "\n\nRuns inside that project's sandbox and starts its container if needed.";
}
// Approval is tied to the reviewed bytes: `expect` is the hash of what was
// displayed; a file rewritten in between is refused and shown again.
function approve(p, expect) {
  if (p.error) die("proposal " + p.id + " is invalid (" + p.error + ") — reject it");
  if (expect && p.hash !== expect) { log("proposal " + p.id + " changed after review — not approved"); return false; }
  addEntry({ name: p.name, when: p.when, project: p.project, kind: p.kind, arg: p.arg }, "approved from " + path.basename(p.project));
  try { fs.unlinkSync(p.file); } catch (e) {}
  console.log("✓ approved " + p.name + " — " + p.when + " · " + p.kind + " " + p.arg + " · " + p.project);
  return true;
}
function reject(ps) {
  for (const p of ps) { try { fs.unlinkSync(p.file); } catch (e) { try { fs.rmSync(p.file, { recursive: true, force: true }); } catch (x) {} } log("rejected " + p.id); }
  console.log("✓ rejected " + ps.map(p => p.id).join(", "));
}
// macOS only, and only when a GUI session can show it (osascript fails
// over SSH). Shown from a detached child so the tick never waits on a
// human; Later/timeout snoozes that exact file version for 4 hours.
function dialog(text, buttons, def) {
  if (!MAC || process.env.AIBOX_DIALOG === "0") return "";
  const script = "display dialog " + JSON.stringify(text) + " with title \"aibox\" buttons {" + buttons.map(b => JSON.stringify(b)).join(",") +
    "} default button " + JSON.stringify(def) + " giving up after 300";
  const r = cp.spawnSync("osascript", ["-e", script], { encoding: "utf8" });
  if (r.status !== 0 || /gave up:true/.test(r.stdout)) return "";
  const m = String(r.stdout).match(/button returned:([^,]*)/); return m ? m[1].trim() : "";
}
function notify(text) {
  if (!MAC || process.env.AIBOX_DIALOG === "0") return;
  cp.spawnSync("osascript", ["-e", "display notification " + JSON.stringify(text) + " with title \"aibox\""]);
}
const snoozeKey = p => p.id + ":" + p.hash;
function snooze(ps) { const s = readJson(SNOOZE, {}); ps.forEach(p => { s[snoozeKey(p)] = now().getTime() + 4 * 3600 * 1000; }); writeJson(SNOOZE, s); }
function pendingToAsk() {
  const s = readJson(SNOOZE, {}), t = now().getTime();
  return proposals().filter(p => !p.error && !(s[snoozeKey(p)] > t));
}
function ask(id, expect) {   // detached child of tick; one dialog at a time
  const lock = path.join(CFG, ".lock-dialog");
  try { fs.mkdirSync(lock); } catch (e) { try { if (Date.now() - fs.statSync(lock).mtimeMs < 10 * 60 * 1000) return; fs.rmdirSync(lock); fs.mkdirSync(lock); } catch (x) { return; } }
  try {
    const p = proposals().find(x => x.id === id); if (!p || p.error) return;
    const same = pendingToAsk().filter(x => x.project === p.project);
    if (same.length > 5) {
      const b = dialog(same.length + " scheduling proposals are waiting from " + path.basename(p.project) + ". Review them with: aibox schedule", ["Reject all", "Later"], "Later");
      if (b === "Reject all") reject(same); else snooze(same);
      return;
    }
    if (p.hash !== expect) return;   // rewritten since the tick looked; next tick re-evaluates
    const b = dialog(describe(p), ["Reject", "Later", "Approve"], "Later");
    if (b === "Approve") approve(p, expect); else if (b === "Reject") reject([p]); else snooze([p]);
  } finally { try { fs.rmdirSync(lock); } catch (e) {} }
}

// ── running ─────────────────────────────────────────────────────
// A pid counts as alive only if it started after this boot (pids recycle).
const bootTime = () => Date.now() - os.uptime() * 1000;
function alive(s) {
  if (!s.pid || !s.started || s.started < bootTime()) return false;
  try { return process.kill(s.pid, 0); } catch (e) { return e.code === "EPERM"; }
}
function runEntry(name) {   // synchronous; spawned detached by tick
  const e = entries().find(x => x.name === name); if (!e) return;
  setState(name, { pid: process.pid, started: Date.now() });
  const fd = fs.openSync(LOG, "a");
  fs.writeSync(fd, "\n" + now().toISOString() + " ▶ " + name + " in " + e.project + "\n");
  const t0 = Date.now();
  const r = cp.spawnSync(AIBOX, ["shell", containerCmd(e)], { cwd: e.project, stdio: ["ignore", fd, fd] });
  const secs = Math.round((Date.now() - t0) / 1000), code = r.status === null ? "signal " + r.signal : r.status;
  fs.writeSync(fd, now().toISOString() + " ■ " + name + " exit " + code + " (" + secs + "s)\n"); fs.closeSync(fd);
  setState(name, { pid: 0, status: code === 0 ? "ok" : "failed (" + code + ")", finished: now().getTime() });
  if (code !== 0) {
    let hint = ""; try { hint = /login expired|not logged in|please run \/login/i.test(fs.readFileSync(LOG, "utf8").slice(-4000)) ? " Login expired — run aibox in any project to log in." : ""; } catch (x) {}
    notify("Scheduled job “" + name + "” failed (exit " + code + ")." + hint + " Details: aibox schedule log");
  }
}
const detach = args => cp.spawn(process.execPath, [__filename, ...args], { detached: true, stdio: "ignore", env: process.env }).unref();
function tick() {
  const lock = path.join(CFG, ".lock-tick");
  try { fs.mkdirSync(lock); } catch (e) {
    try { if (Date.now() - fs.statSync(lock).mtimeMs < 10 * 60 * 1000) return; fs.rmdirSync(lock); fs.mkdirSync(lock); } catch (x) { return; }
  }
  try {
    const t = now(), es = entries();
    for (const e of es) {
      const w = parseWhen(e.when), due = w && lastDue(w, t), s = getState(e.name);
      if (!due || due.getTime() <= (s.last || 0)) continue;
      setState(e.name, { last: t.getTime() });   // before spawning: a crash must not re-fire every minute
      if (alive(s)) { log("skip " + e.name + ": previous run still going (pid " + s.pid + ")"); continue; }
      detach(["run", e.name]);
    }
    // on-start entries: aibox checks a per-boot marker in the container and
    // runs them once; skipped quietly when docker or the container is down.
    for (const project of [...new Set(es.filter(e => e.when === "on-start").map(e => e.project))])
      cp.spawnSync(AIBOX, ["onstart-check"], { cwd: project, stdio: "ignore", timeout: 120000 });
    const p = pendingToAsk()[0]; if (p) detach(["ask", p.id, p.hash]);
  } finally { try { fs.rmdirSync(lock); } catch (e) {} }
}

// ── the every-minute trigger ────────────────────────────────────
// PATH is captured at install time: launchd/cron give a login shell that
// knows nothing of Homebrew or nvm, and the tick needs node, docker, colima.
const PLIST = path.join(os.homedir(), "Library", "LaunchAgents", "dev.aibox.schedule.plist"), MARK = "# aibox-schedule";
const xml = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");
const tickCmd = () => shq(AIBOX) + " schedule tick";
function installed() { return MAC ? fs.existsSync(PLIST) : /aibox-schedule/.test(crontab()); }
function crontab() { const r = cp.spawnSync("crontab", ["-l"], { encoding: "utf8" }); return r.status === 0 ? r.stdout : ""; }
function install() {
  if (MAC) {
    fs.mkdirSync(path.dirname(PLIST), { recursive: true });
    fs.writeFileSync(PLIST, `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.aibox.schedule</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>${xml(tickCmd())}</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>${xml(process.env.PATH || "/usr/local/bin:/usr/bin:/bin")}</string></dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardErrorPath</key><string>${xml(path.join(CFG, "schedule-agent.log"))}</string>
</dict></plist>
`);
    const dom = "gui/" + process.getuid();
    cp.spawnSync("launchctl", ["bootout", dom, PLIST]);
    if (cp.spawnSync("launchctl", ["bootstrap", dom, PLIST]).status !== 0) cp.spawnSync("launchctl", ["load", "-w", PLIST]);
    console.log("✓ scheduler on: launchd runs `aibox schedule tick` every minute (aibox schedule off to stop)");
  } else {
    const lines = crontab().split("\n").filter(l => l && !l.includes(MARK));
    lines.push("* * * * * PATH=" + shq(process.env.PATH || "/usr/local/bin:/usr/bin:/bin") + " /bin/bash -c " + shq(tickCmd()) + " " + MARK);
    const r = cp.spawnSync("crontab", ["-"], { input: lines.join("\n") + "\n" });
    if (r.status !== 0) die("could not install the crontab line; add it yourself: * * * * * /bin/bash -c " + shq(tickCmd()));
    console.log("✓ scheduler on: cron runs `aibox schedule tick` every minute (aibox schedule off to stop)");
  }
}
function uninstall() {
  if (MAC) { cp.spawnSync("launchctl", ["bootout", "gui/" + process.getuid(), PLIST]); try { fs.unlinkSync(PLIST); } catch (e) {} }
  else { const lines = crontab().split("\n").filter(l => l && !l.includes(MARK)); cp.spawnSync("crontab", ["-"], { input: lines.length ? lines.join("\n") + "\n" : "" }); }
  console.log("✓ scheduler off (entries kept; aibox schedule on to resume)");
}

// ── CLI ─────────────────────────────────────────────────────────
function list() {
  const es = entries(), t = now();
  if (!es.length) console.log("No scheduled jobs. Add one from a project dir:  aibox schedule add <name> \"daily 08:00\" claude <prompt-file>");
  for (const e of es) {
    const w = parseWhen(e.when), s = getState(e.name);
    const last = alive(s) ? "running since " + fmt(new Date(s.started)) : s.status ? s.status + " " + fmt(new Date(s.finished)) : "never run";
    console.log(e.name.padEnd(14) + e.when.padEnd(16) + path.basename(e.project).padEnd(20) + (e.kind + " " + e.arg).slice(0, 44).padEnd(46) +
      (w.kind === "on-start" ? "on container start" : "next " + fmt(nextDue(w, t))) + " · " + last);
  }
  const ps = proposals();
  if (ps.length) {
    console.log("\nProposals waiting (aibox schedule approve <name> / reject <name>):");
    for (const p of ps) console.log("  " + p.name.padEnd(14) + (p.error ? "INVALID (" + p.error + ")" : p.when.padEnd(16) + path.basename(p.project).padEnd(20) + p.kind + " " + p.arg));
  }
  if (es.length && !installed()) console.log("\nScheduler is OFF — nothing runs until: aibox schedule on");
}
function main() {
  if (!CFG) die("AIBOX_CFG not set");
  const [cmd, ...a] = process.argv.slice(2);
  switch (cmd || "list") {
    case "list": return list();
    case "add": {
      const [name, when, kind, ...rest] = a;
      if (!name || !when || !kind) die("usage: aibox schedule add <name> \"<when>\" claude <prompt-file> | run \"<command>\"  (from the project directory)");
      addEntry({ name, when, project: process.env.AIBOX_PROJECT, kind, arg: rest.join(" ") }, "added by user");
      return console.log("✓ " + name + ": " + parseWhen(when).text + " in " + process.env.AIBOX_PROJECT);
    }
    case "rm": { const l = entries(); if (!l.some(e => e.name === a[0])) die("no job named " + a[0]); writeJson(REG, l.filter(e => e.name !== a[0])); log("removed " + a[0]); return console.log("✓ removed " + a[0]); }
    case "approve": return approve(findProposal(a[0] || die("usage: aibox schedule approve <name>")));
    case "reject": return reject(a[0] === "all" ? proposals() : [findProposal(a[0] || die("usage: aibox schedule reject <name>|all"))]);
    case "on": return install();
    case "off": return uninstall();
    case "tick": return tick();
    case "run": return runEntry(a[0]);
    case "ask": return ask(a[0], a[1]);
    case "on-start": return installed() && entries().filter(e => e.when === "on-start" && e.project === a[0]).forEach(e => console.log(containerCmd(e)));
    case "log": { let s = ""; try { s = fs.readFileSync(LOG, "utf8"); } catch (e) {} const ls = s.split("\n"); return console.log((a[0] ? ls.filter(l => l.includes(a[0])) : ls).slice(-60).join("\n")); }
    default: die("aibox schedule [list|add|rm|approve|reject|on|off|log]");
  }
}
if (require.main === module) main();
module.exports = { parseWhen, lastDue, nextDue, validate, containerCmd, safeRead };
SCHEDJS
}

# The aibox binary as an absolute path, for launchd and the sessions page
# (env and PATH do not reliably survive open/launchd).
_aibox_bin() {
  command -v aibox 2>/dev/null || realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0"
}

cmd_schedule() {
  mkdir -p "${CONFIG_DIR}/inbox"
  _write_schedule_js
  AIBOX_CFG="$CONFIG_DIR" AIBOX_BIN="$(_aibox_bin)" AIBOX_PROJECT="$PROJECT_DIR" node "${CONFIG_DIR}/schedule.js" "$@"
}

# Pending proposals from containers — a one-line nudge on ordinary runs.
_remind_proposals() {
  local n
  n="$(find "${CONFIG_DIR}/inbox" -mindepth 2 -maxdepth 2 -type f ! -name '.*' 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ "${n:-0}" -gt 0 ]] && _info "${n} scheduling proposal(s) waiting — review with: aibox schedule"
  return 0
}

# ── GPU browser (macOS): a Playwright server on the Mac for sessions ──
# Containers get no GPU (Colima, Docker Desktop and OrbStack pass none
# through), so headless Chromium inside renders WebGL on the CPU. `aibox
# browser` runs a Playwright browser server ON THE MAC as a hidden,
# unprivileged user ("render": own node, own Playwright, own home) inside
# that user's launchd domain (Chrome's Mach services need one). Sessions
# read the ws URL from ~/.aibox/proposals/.browser-url and connect through
# host.docker.internal; the browser sees that user's files, never yours.
RENDER_USER=render
RENDER_HOME=/var/render
BROWSER_PORT=3145
# Run a shell string as the render user, in its launchd domain, from its
# home, with its own node first on PATH. sudo asks for your password.
_render_sh() {
  local uid
  uid="$(id -u "$RENDER_USER" 2>/dev/null)" || _die "No '${RENDER_USER}' user yet — run: aibox browser setup"
  sudo launchctl asuser "$uid" sudo -u "$RENDER_USER" -H env "PATH=${RENDER_HOME}/node/bin:/usr/bin:/bin" bash -c "cd ~ && $1"
}
_browser_setup() {
  if ! id -u "$RENDER_USER" >/dev/null 2>&1; then
    _info "Creating hidden user '${RENDER_USER}' (sudo asks for your password)..."
    sudo sysadminctl -addUser "$RENDER_USER" -fullName "aibox render" -shell /bin/zsh -home "$RENDER_HOME" >/dev/null 2>&1 \
      || _die "sysadminctl could not create the user."
    sudo dscl . -create "/Users/${RENDER_USER}" IsHidden 1
  fi
  sudo mkdir -p "$RENDER_HOME" && sudo chown "${RENDER_USER}:staff" "$RENDER_HOME" && sudo chmod 750 "$RENDER_HOME"
  # Your home is group-readable by default and render is in staff: close it,
  # or the browser could read ~/Projects through file:// URLs.
  if [[ "$(stat -f %Lp "$HOME")" != "700" ]]; then
    _info "Closing ${HOME} to other local users (chmod 700)."
    chmod 700 "$HOME"
  fi
  local arch
  case "$(uname -m)" in arm64) arch=darwin-arm64 ;; *) arch=darwin-x64 ;; esac
  _info "Installing node and Playwright for '${RENDER_USER}' (a few minutes, one time)..."
  _render_sh '[ -x node/bin/node ] || { f=$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt | grep -o "node-v22[^ ]*'"$arch"'.tar.gz" | head -1) && curl -fsSL "https://nodejs.org/dist/latest-v22.x/$f" | tar xz && rm -rf node && mv "${f%.tar.gz}" node; }'
  _render_sh '[ -d node_modules/@playwright/test ] || { npm init -y >/dev/null && npm i @playwright/test@latest >/dev/null; }; npx playwright install chromium >/dev/null && node -e "console.log(require(\"@playwright/test/package.json\").version)" > .pw-version'
  _render_sh 'cat > serve.js <<"EOF"
// aibox GPU browser server: full Chromium in new-headless mode (Metal via
// ANGLE), one browser shared by all connecting sessions, each in its own
// context. Started by `aibox browser` on the Mac; stop with `aibox browser stop`.
const { chromium } = require("@playwright/test");
const wsPath = "/" + require("crypto").randomBytes(8).toString("hex");
chromium.launchServer({ channel: "chromium", headless: true, host: "127.0.0.1", port: '"$BROWSER_PORT"', wsPath })
  .then(s => console.log("Listening on " + s.wsEndpoint()));
EOF
cat > README.md <<"EOF"
# render - GPU browser server for aibox sessions
Hidden, unprivileged macOS account created by `aibox browser setup`. No login
password; used only via sudo. Its one job: run a Playwright browser server on
the Mac so sandboxed aibox sessions (Docker in Colima) can render WebGL/WebGPU
with the real GPU instead of SwiftShader.
Why a separate user: a Playwright browser can open file:// and read whatever
its account can read. As render it sees /var/render and system files, never
the home of the person running aibox (which setup makes chmod 700).
Everything here is private to this account: node/ (official tarball),
node_modules/ (Playwright), serve.js (the server), server.log, .pw-version.
Start / stop / status:  aibox browser  |  aibox browser stop  |  aibox browser status
It must run in its own launchd domain (sudo launchctl asuser <uid> ...),
which aibox does; a plain sudo -u render makes Chrome die at startup.
Clients send the header Host: 127.0.0.1:3145 (anything else gets 403).
Update Playwright:  aibox browser setup   (reinstalls to latest)
Remove everything:  aibox browser stop; sudo sysadminctl -deleteUser render; sudo rm -rf /var/render
EOF'
  _ok "'${RENDER_USER}' is ready (Playwright $(cat "${RENDER_HOME}/.pw-version" 2>/dev/null)). Start the server with: aibox browser"
}
_browser_running() { pgrep -u "$RENDER_USER" -f "node serve.js" >/dev/null 2>&1; }
# Every project inbox gets (or loses) the .browser-url dotfile, which the
# proposal lister ignores and the container reads at ~/.aibox/proposals/.
_browser_sync() {
  local d
  for d in "${CONFIG_DIR}"/inbox/*/; do
    [[ -d "$d" ]] || continue
    if [[ -f "${CONFIG_DIR}/browser.url" ]]; then cp "${CONFIG_DIR}/browser.url" "${d}.browser-url"; else rm -f "${d}.browser-url"; fi
  done
}
_browser_start() {
  [[ -f "${RENDER_HOME}/serve.js" ]] || _die "Not set up yet — run: aibox browser setup"
  if ! _browser_running; then
    _info "Starting the GPU browser server (sudo may ask for your password)..."
    _render_sh 'rm -f server.log; nohup node serve.js > server.log 2>&1 &'
    local i=0
    until grep -q "ws://" "${RENDER_HOME}/server.log" 2>/dev/null; do
      (( i++ >= 30 )) && _die "The server did not start — see ${RENDER_HOME}/server.log"
      sleep 1
    done
  fi
  local url ver
  url="$(grep -o 'ws://[^ ]*' "${RENDER_HOME}/server.log" | tail -1)"
  ver="$(cat "${RENDER_HOME}/.pw-version" 2>/dev/null)"
  printf '%s\n%s\n' "${url/127.0.0.1/host.docker.internal}" "$ver" > "${CONFIG_DIR}/browser.url"
  _browser_sync
  _ok "GPU browser server running: ${url} (Playwright ${ver})."
  _info "Sessions find it at ~/.aibox/proposals/.browser-url (CLAUDE.md explains the rest). Stop with: aibox browser stop"
}
_browser_stop() {
  _browser_running && sudo pkill -u "$RENDER_USER" -f "node serve.js" || true
  rm -f "${CONFIG_DIR}/browser.url"; _browser_sync
  _ok "GPU browser server stopped."
}
cmd_browser() {
  [[ "$(uname)" == "Darwin" ]] || _die "aibox browser is macOS-only: it runs a GPU browser on the Mac for sessions. On Linux, run a Playwright server with your GPU yourself and give sessions its URL."
  case "${1:-start}" in
    setup) _browser_setup ;;
    start) _browser_start ;;
    stop)  _browser_stop ;;
    status) if _browser_running; then _ok "running: $(grep -o 'ws://[^ ]*' "${RENDER_HOME}/server.log" | tail -1)"; else _info "not running — start with: aibox browser"; fi ;;
    *) _die "Usage: aibox browser [setup|start|stop|status]" ;;
  esac
}

# ── Sessions page (host-side, foreground, all projects) ──────────
# `aibox sessions` runs a small Node server ON THE HOST (node is present by
# construction — aibox installs via npm), loopback-only, and opens the
# browser. Not a daemon: Ctrl-C or the page's Close button ends it. Listing
# is read via a throwaway container with the volume mounted read-only; the
# Terminal/Phone actions shell back into aibox itself.
cmd_sessions() {
  _ensure_docker
  _ensure_image
  command -v node >/dev/null 2>&1 \
    || _die "aibox sessions needs node on the host (it comes with the npm install of aibox)."

  cat > "${CONFIG_DIR}/sessions-lister.js" <<'LISTER'
// Runs inside a container with the aibox-home volume mounted read-only at
// /v (AIBOX_LIST_ROOT overrides the root, for testing outside docker). Prints all projects' sessions
// as JSON on stdout.
const fs = require("fs"), path = require("path");
const ROOT = process.env.AIBOX_LIST_ROOT || "/v";
// Deep search: with AIBOX_SEARCH set, only sessions whose metadata OR full
// transcript contains the (case-insensitive) query are emitted.
const Q = (process.env.AIBOX_SEARCH || "").toLowerCase().slice(0, 200);
function fileHas(p, q) {
  try {
    const fd = fs.openSync(p, "r"), CH = 4 * 1024 * 1024, b = Buffer.alloc(CH);
    // StringDecoder buffers a codepoint split across chunk reads — a plain
    // per-chunk toString would mangle it and silently miss the match.
    const dec = new (require("string_decoder").StringDecoder)("utf8");
    let pos = 0, carry = "";
    for (;;) {
      const n = fs.readSync(fd, b, 0, CH, pos);
      if (n <= 0) break;
      const s = carry + dec.write(b.slice(0, n));
      if (s.toLowerCase().includes(q)) { fs.closeSync(fd); return true; }
      carry = s.slice(-q.length);   // query straddling a chunk boundary
      pos += n;
      if (n < CH) break;
    }
    fs.closeSync(fd);
  } catch (e) {}
  return false;
}
function msgText(m) {
  const c = m.content;
  const t = typeof c === "string" ? c : Array.isArray(c) ? c.map(x => x.text || "").join(" ") : "";
  return t.replace(/\s+/g, " ").trim();
}
function parseLine(l) { try { return JSON.parse(l); } catch (e) { return null; } }
// Title prefers Claude Code's own summary records (what its resume picker
// shows); falls back to the first real user message. `last` is the tail of
// the conversation — the most recent assistant text. Reads only a head and
// a tail window, transcripts can be many MB.
function info(file, size) {
  let head = "", tail = "";
  try {
    const fd = fs.openSync(file, "r");
    const rd = (pos, len) => {
      const b = Buffer.alloc(len), n = fs.readSync(fd, b, 0, len, pos);
      return b.slice(0, n).toString("utf8");
    };
    head = rd(0, 262144);
    if (size > 262144) tail = rd(Math.max(0, size - 131072), 131072);
    fs.closeSync(fd);
  } catch (e) { return { title: "Untitled session", summary: "", last: "", lastUser: "" }; }
  let firstUser = "", summary = "", last = "";
  for (const l of head.split("\n")) {
    const j = parseLine(l); if (!j) continue;
    if (j.type === "summary" && j.summary) summary = j.summary;
    if (!firstUser && j.type === "user" && j.message && !j.isMeta) {
      const t = msgText(j.message);
      if (t && !t.startsWith("Caveat:") && !t.startsWith("<command-")) firstUser = t;
    }
  }
  const tl = (tail || head).split("\n");
  let tailSummary = "", lastUser = "";
  for (let i = tl.length - 1; i >= 0; i--) {
    const j = parseLine(tl[i]); if (!j) continue;
    if (!tailSummary && j.type === "summary" && j.summary) tailSummary = j.summary;
    if (!last && j.type === "assistant" && j.message) {
      const t = msgText(j.message);
      if (t) last = t.slice(0, 2000);
    }
    if (!lastUser && j.type === "user" && j.message && !j.isMeta) {
      const t = msgText(j.message);
      if (t && !t.startsWith("Caveat:") && !t.startsWith("<command-")) lastUser = t.slice(0, 500);
    }
    if (last && lastUser && tailSummary) break;
  }
  const sum = tailSummary || summary;
  return {
    title: (sum || firstUser || "Untitled session").slice(0, 100),
    summary: sum.slice(0, 600),
    last: last,
    lastUser: lastUser
  };
}
const out = [];
function addDir(dir, ppath, label) {
  let files = []; try { files = fs.readdirSync(dir); } catch (e) { return; }
  for (const f of files) {
    if (!f.endsWith(".jsonl")) continue;
    // Filenames are agent-written: only a bare uuid may become an id that
    // the host page later puts into a shell command.
    if (!/^[0-9a-f-]{36}$/.test(f.slice(0, -6))) continue;
    try {
      const p = path.join(dir, f), st = fs.statSync(p), inf = info(p, st.size);
      if (Q) {
        const meta = (inf.title + " " + inf.summary + " " + inf.last + " " + inf.lastUser + " " + label + " " + f).toLowerCase();
        if (!meta.includes(Q) && !fileHas(p, Q)) continue;
      }
      out.push({ project: ppath, label: label, id: f.slice(0, -6), mtime: st.mtimeMs,
                 title: inf.title, summary: inf.summary, last: inf.last, lastUser: inf.lastUser });
    } catch (e) {}
  }
}
// New layout: per-project slices.
let hashes = [];
try { hashes = fs.readdirSync(path.join(ROOT, "projects")); } catch (e) {}
for (const h of hashes) {
  const base = path.join(ROOT, "projects", h);
  // A slice without its .aibox-path sentinel (pre-fix migrations wrote
  // none) is still listed — pathless, so copy-only, labelled by hash.
  let ppath = "";
  try { ppath = fs.readFileSync(path.join(base, ".aibox-path"), "utf8"); } catch (e) {}
  const cp = path.join(base, "claude-projects");
  let encs = []; try { encs = fs.readdirSync(cp); } catch (e) {}
  for (const enc of encs) addDir(path.join(cp, enc), ppath, ppath || "slice " + h);
}
// Legacy / not-yet-migrated layout (and post-migration leftovers). Dir
// names are lossy encodings; real paths come from .claude.json KEYS with
// the same rule the migration uses. Unmatched dirs are listed anyway with
// no project path — the page then offers copy-only.
const legacyRoot = path.join(ROOT, ".claude", "projects");
let legacy = []; try { legacy = fs.readdirSync(legacyRoot); } catch (e) {}
if (legacy.length) {
  const map = {};
  try {
    const cj = fs.readFileSync(path.join(ROOT, ".claude", ".claude.json"), "utf8");
    for (const m of cj.matchAll(/"(\/[^"]*)":/g)) map[m[1].replace(/[^a-zA-Z0-9]/g, "-")] = m[1];
  } catch (e) {}
  for (const enc of legacy) addDir(path.join(legacyRoot, enc), map[enc] || "", map[enc] || enc);
}
