      acts.appendChild(bT);
    }
    const bC=el("button",null,"Copy resume command");
    bC.onclick=()=>{
      const cmd=s.project?("cd "+shq(s.project)+" && aibox --resume "+s.id):("aibox --resume "+s.id);
      navigator.clipboard.writeText(cmd).then(
        ()=>say(s.project?"Copied — paste into any terminal tab.":"Copied — run inside that project directory (its path isn't recorded)."),
        ()=>say("Copy failed — select the command manually."))};
    acts.appendChild(bC);
    if(s.project){
      const bP=el("button",null,"Send to phone");
      bP.onclick=resume(()=>act(s.project,s.id,"rc","Registering — watch the Claude app’s session list."),
        "This session looks active in another window. Sending it to your phone starts a SECOND Claude on the same conversation. Continue?");
      acts.appendChild(bP);
    }
    row.appendChild(acts);
    box.appendChild(row);
  });
}
