function ago(ms){const s=(Date.now()-ms)/1e3;if(s<90)return "just now";const m=s/60,h=m/60,d=h/24,w=d/7;
  if(m<90)return Math.round(m)+" minutes ago";if(h<36)return Math.round(h)+" hours ago";
  if(d<10)return Math.round(d)+" days ago";return Math.round(w)+" weeks ago"}
function render(list){
