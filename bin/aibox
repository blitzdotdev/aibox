function spawnSession(args) {
  const c = cp.spawn("script", ["-qfc", "claude " + args + " --remote-control", "/dev/null"],
    { detached: true, stdio: "ignore", cwd: process.cwd() });
  c.on("error", function () {});
  c.unref();
}
http.createServer((req, res) => {
  let u;
  // Request-targets like "//" make new URL() throw — a crash here would
  // kill the whole UI.
  try { u = new URL(req.url, "http://x"); } catch (e) { res.writeHead(400); return res.end("bad request"); }
  // *.aibox.localhost is loopback in the browser, so any web page could POST
  // here through the proxy; only this page's own origin may. (The proxy
  // passes Host through unchanged, so Origin equals "http://" + Host.)
  if (req.method === "POST" && (req.headers.origin || "") !== "http://" + (req.headers.host || "")) {
    res.writeHead(403); return res.end("forbidden");
  }
  if (req.method === "POST" && u.pathname === "/api/new") {
    const id = require("crypto").randomUUID();
    spawnSession("--session-id " + id);
    res.writeHead(200, { "content-type": "application/json" });
    return res.end(JSON.stringify({ ok: true, id: id }));
  }
  if (req.method === "POST" && u.pathname === "/api/stop") {
    const id = String(u.searchParams.get("id") || "");
    if (!/^[0-9a-f-]{36}$/.test(id)) { res.writeHead(400); return res.end("bad id"); }
    // id is regex-vetted above, so interpolating it into the shell is safe
    cp.exec("pkill -f -- \"(--resume|--session-id)[= ]" + id + "\" || true", () => {
      res.writeHead(200, { "content-type": "application/json" });
      res.end("{\"ok\":true}");
    });
    return;
  }
  if (req.method === "POST" && u.pathname === "/api/resume") {
    const id = String(u.searchParams.get("id") || "");
    if (!/^[0-9a-f-]{36}$/.test(id)) { res.writeHead(400); return res.end("bad id"); }
    return liveIds(live => {
      // Double-resume would attach two claude processes to one transcript
      // (clients on several devices share this page).
      if (live.has(id)) { res.writeHead(409); return res.end("already live"); }
      spawnSession("--resume " + id);
      res.writeHead(200, { "content-type": "application/json" });
      res.end("{\"ok\":true}");
    });
  }
  if (u.pathname === "/api/sessions") {
    return sessions(list => {
      res.writeHead(200, { "content-type": "application/json" });
      res.end(JSON.stringify(list));
    });
  }
  res.writeHead(200, { "content-type": "text/html; charset=utf-8" });
  res.end(PAGE);
  // Container-wide bind is what lets the dev proxy reach us; the accepted
  // trade-off is that other containers on the aibox network can reach it
  // too. Endpoints only spawn/stop sessions of THIS project.
}).listen(PORT, "0.0.0.0");
UIJS
  if ! docker exec -u aibox "$CONTAINER" pgrep -f aibox-serve-ui >/dev/null 2>&1; then
    # The tag rides as an (ignored) node argv so it survives exec and is
    # visible to pgrep/pkill — a comment in bash -c would be erased by exec.
    docker exec -d -u aibox -w "$PROJECT_DIR" "$CONTAINER" bash -c \
      'exec node "$HOME/.aibox-serve/ui.js" aibox-serve-ui >>"$HOME/.aibox-serve/ui.log" 2>&1'
  fi

  _ok "Sessions UI: $(_dev_url 45789) — new session, resume, live list."
  _info "Sessions started there register with claude.ai (Claude app included) and keep running after this terminal closes. End everything with: aibox serve stop"
}

# Plumbing for the host-side sessions page (and handy on its own): make one
# past session of THIS project drivable from claude.ai / the Claude app.
cmd_rc_resume() {
  [[ "${1:-}" =~ ^[0-9a-f-]{36}$ ]] || _die "Usage: aibox rc-resume <session-id>"
  _ensure_all
  _ensure_claude_bin
  docker exec -d -u aibox -w "$PROJECT_DIR" "$CONTAINER" \
    script -qfc "claude --resume $1 --remote-control" /dev/null
  _ok "Session registering — it appears in the claude.ai / Claude app list shortly."
}

# ── Schedule (host-side jobs that run inside project sandboxes) ──
# One launchd agent (macOS) / crontab line (Linux) runs `aibox schedule
# tick` every minute. Entries live in ~/.aibox/schedule.json on the HOST;
# each runs as `aibox shell <cmd>` in its project, so nothing in the
# registry can execute outside a container. Containers can only write
# proposals into their own inbox mount, which the tick surfaces for
# approval. The logic is Node (date math is the same on macOS and Linux).
_write_schedule_js() {
  cat > "${CONFIG_DIR}/schedule.js" <<'SCHEDJS'
// aibox schedule — host-side scheduler. Generated by aibox (rewritten on
// every `aibox schedule` run). One launchd agent (macOS) or crontab line
// (Linux) runs `aibox schedule tick` every minute; the tick starts due
// jobs, each as `aibox shell '<cmd>'` in its project, re-launches on-start
// entries after a container (re)boot, and surfaces pending proposals from
// containers. Registry and state live in ~/.aibox; the only thing a
// container can write is its own inbox of proposals.
const fs = require("fs"), path = require("path"), cp = require("child_process"), os = require("os"), crypto = require("crypto");
const CFG = process.env.AIBOX_CFG || "", AIBOX = process.env.AIBOX_BIN || "aibox";
const REG = path.join(CFG, "schedule.json"), STATE_DIR = path.join(CFG, "schedule-state"), SNOOZE = path.join(CFG, "schedule-snooze.json");
const LOG = path.join(CFG, "schedule.log"), INBOX = path.join(CFG, "inbox");
const MAC = process.platform === "darwin";
const NAME_RE = /^[a-z0-9][a-z0-9-]{0,31}$/, MAX_PROPOSAL = 2048, MAX_PREVIEW = 4096;
const now = () => process.env.AIBOX_NOW ? new Date(Number(process.env.AIBOX_NOW)) : new Date();
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch (e) { return d; } };
// Per-process temp name: several processes (tick + run children) write
// state at once, and a shared temp name loses writes.
function writeJson(f, o) { const t = f + "." + process.pid + ".tmp"; fs.writeFileSync(t, JSON.stringify(o, null, 2) + "\n"); fs.renameSync(t, f); }
const shq = s => "'" + String(s).replace(/'/g, "'\\''") + "'";
const log = line => fs.appendFileSync(LOG, now().toISOString() + " " + line + "\n");
const die = msg => { console.error("✗ " + msg); process.exit(1); };
// Bounded read of a REGULAR file only: inbox files and prompt files are
// written inside containers, so a FIFO, a symlink to /dev/zero, a
// directory, or a huge file must not hang or crash the tick.
function safeRead(file, max) {
  let fd = null;
  try {
    if (!fs.lstatSync(file).isFile()) return null;
    fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
    const st = fs.fstatSync(fd); if (!st.isFile() || st.size > max) return null;
    const buf = Buffer.alloc(max), n = fs.readSync(fd, buf, 0, max, 0);
    return buf.slice(0, n).toString("utf8");
  } catch (e) { return null; } finally { if (fd !== null) fs.closeSync(fd); }
}

// ── schedule forms ──────────────────────────────────────────────
// daily HH:MM · weekdays HH:MM · every Nm|Nh (5m…24h, counted from local
// midnight) · on-start
function parseWhen(s) {
  s = String(s || "").trim().toLowerCase(); let m;
  if (s === "on-start") return { kind: "on-start", text: s };
  if ((m = s.match(/^(daily|weekdays) ([01]?\d|2[0-3]):([0-5]\d)$/)))
    return { kind: m[1], h: +m[2], min: +m[3], text: m[1] + " " + String(+m[2]).padStart(2, "0") + ":" + m[3] };
  if ((m = s.match(/^every (\d{1,3})(m|h)$/))) {
    const n = +m[1] * (m[2] === "h" ? 60 : 1);
    if (n >= 5 && n <= 1440) return { kind: "every", minutes: n, text: s };
  }
  return null;
}
// Latest due time at or before t (local time); null if none / on-start.
function lastDue(w, t) {
  if (w.kind === "every") {
    const d = new Date(t), slot = Math.floor((t.getHours() * 60 + t.getMinutes()) / w.minutes) * w.minutes;
    d.setHours(0, slot, 0, 0); return d;
  }
  if (w.kind !== "daily" && w.kind !== "weekdays") return null;
  for (let back = 0; back < 8; back++) {
    const d = new Date(t); d.setDate(d.getDate() - back); d.setHours(w.h, w.min, 0, 0);
    if (d > t) continue;
    if (w.kind === "weekdays" && (d.getDay() === 0 || d.getDay() === 6)) continue;
    return d;
  }
  return null;
}
function nextDue(w, t) {
  if (w.kind === "every") {
    const d = new Date(t), slot = (Math.floor((t.getHours() * 60 + t.getMinutes()) / w.minutes) + 1) * w.minutes;
    d.setHours(0, slot, 0, 0); return d;
  }
  if (w.kind !== "daily" && w.kind !== "weekdays") return null;
  for (let fwd = 0; fwd < 8; fwd++) {
    const d = new Date(t); d.setDate(d.getDate() + fwd); d.setHours(w.h, w.min, 0, 0);
    if (d <= t) continue;
    if (w.kind === "weekdays" && (d.getDay() === 0 || d.getDay() === 6)) continue;
    return d;
  }
  return null;
}
const fmt = d => d ? d.toLocaleString(undefined, { weekday: "short", hour: "2-digit", minute: "2-digit", month: "short", day: "numeric" }) : "–";

// ── entries ─────────────────────────────────────────────────────
// kind "claude": a prompt file runs as a fresh headless session with a
// fixed, reviewable flag set (prompt on stdin, so a file starting with
// "---" is not parsed as an option). kind "run": one shell line.
function containerCmd(e) {
  if (e.kind === "claude") return "claude -p --permission-mode auto --permission-prompts none --max-turns 30 < " + shq(e.arg);
  return e.arg;
}
function validate(e) {
  if (!NAME_RE.test(e.name || "")) return "name must be 1–32 chars of a-z, 0-9, dashes";
  const w = parseWhen(e.when); if (!w) return "when must be: daily HH:MM · weekdays HH:MM · every 30m / every 2h · on-start";
  if (!e.project || !path.isAbsolute(e.project) || !fs.existsSync(e.project)) return "project directory not found: " + e.project;
  if (e.kind === "claude") {
    if (!e.arg || e.arg.split(/[\\/]/).includes("..") || path.isAbsolute(e.arg)) return "claude needs a prompt file path relative to the project";
    if (safeRead(path.join(e.project, e.arg), MAX_PREVIEW) === null) return "prompt file missing or not a small regular file: " + e.arg;
    if (w.kind === "on-start") return "an on-start entry must be a run command";
  } else if (e.kind === "run") {
    if (!e.arg || e.arg.length > 200 || /[\r\n]/.test(e.arg)) return "run command must be 1–200 chars on one line (put longer ones in a script)";
  } else return "kind must be claude or run";
  return null;
}
const entries = () => readJson(REG, []);
const getState = name => readJson(path.join(STATE_DIR, name + ".json"), {});
function setState(name, patch) { fs.mkdirSync(STATE_DIR, { recursive: true }); const f = path.join(STATE_DIR, name + ".json"); writeJson(f, Object.assign(readJson(f, {}), patch)); }
function addEntry(e, source) {
  const err = validate(e); if (err) die(err);
  const all = entries(), clash = all.find(x => x.name === e.name && x.project !== e.project);
  if (clash) die("the name " + e.name + " is already used by " + clash.project + " — remove it (aibox schedule rm " + e.name + ") or pick another name");
  const list = all.filter(x => x.name !== e.name);   // same project + same name: replace
  list.push({ name: e.name, when: parseWhen(e.when).text, project: e.project, kind: e.kind, arg: e.arg, added: now().toISOString() });
  writeJson(REG, list);
  setState(e.name, { last: now().getTime() });   // waits for the NEXT occurrence
  log("added " + e.name + " (" + source + "): " + e.when + " · " + e.kind + " " + e.arg + " · " + e.project);
  if (!installed()) install();
}

// ── proposals (from containers, via the per-project inbox mount) ────
// File <inbox>/<hash6>/<name>: line 1 = when, line 2 = "claude <file>" or
// "run <command>". <hash6>.path (written by aibox on the host) names the
// project — the sender is the mount, never a field in the file. Invalid
// ones are never deleted automatically (Claude may still be writing the
// prompt file); they show as INVALID until rejected.
function proposals() {
  const out = [];
  let dirs = []; try { dirs = fs.readdirSync(INBOX).filter(d => !d.startsWith(".") && !d.endsWith(".path")); } catch (e) {}
  for (const h of dirs) {
    let project = ""; try { project = fs.readFileSync(path.join(INBOX, h + ".path"), "utf8").trim(); } catch (e) {}
    let files = []; try { files = fs.readdirSync(path.join(INBOX, h)).filter(f => !f.startsWith(".")); } catch (e) {}
    for (const f of files) {
      const file = path.join(INBOX, h, f), p = { id: h + "/" + f, name: f, project, file, error: null, when: "", kind: "", arg: "", hash: "" };
      try {
        const text = safeRead(file, MAX_PROPOSAL);
        if (text === null) { p.error = "not a small regular file"; }
        else {
          p.hash = crypto.createHash("sha256").update(text).digest("hex").slice(0, 16);
          const lines = text.split("\n").map(s => s.trim()).filter(Boolean);
          p.when = lines[0] || ""; const m = (lines[1] || "").match(/^(claude|run)\s+(.+)$/); if (m) { p.kind = m[1]; p.arg = m[2]; }
          p.error = validate(p);
        }
      } catch (e) { p.error = "unreadable"; }
      out.push(p);
    }
  }
  return out;
}
// A bare name is enough unless two projects proposed the same name.
function findProposal(ref) {
  const all = proposals(), hits = all.filter(p => p.id === ref || p.name === ref);
  if (!hits.length) die("no proposal named " + ref + " (aibox schedule lists them)");
  if (hits.length > 1) die("several projects proposed " + ref + " — use one of: " + hits.map(p => p.id).join(", "));
  return hits[0];
}
function describe(p) {
  const proj = path.basename(p.project || "?");
  let what = p.kind === "claude" ? "Claude runs the prompt file " + p.arg : "runs: " + p.arg;
  if (p.kind === "claude" && !p.error) {
    const t = safeRead(path.join(p.project, p.arg), MAX_PREVIEW);
    if (t) what += "\n\n" + t.split("\n").slice(0, 10).join("\n").slice(0, 600);
  }
  return "Project " + proj + " proposes “" + p.name + "”: " + p.when + "\n" + what + "\n\nRuns inside that project's sandbox and starts its container if needed.";
}
// Approval is tied to the reviewed bytes: `expect` is the hash of what was
// displayed; a file rewritten in between is refused and shown again.
function approve(p, expect) {
  if (p.error) die("proposal " + p.id + " is invalid (" + p.error + ") — reject it");
  if (expect && p.hash !== expect) { log("proposal " + p.id + " changed after review — not approved"); return false; }
  addEntry({ name: p.name, when: p.when, project: p.project, kind: p.kind, arg: p.arg }, "approved from " + path.basename(p.project));
  try { fs.unlinkSync(p.file); } catch (e) {}
  console.log("✓ approved " + p.name + " — " + p.when + " · " + p.kind + " " + p.arg + " · " + p.project);
  return true;
}
function reject(ps) {
  for (const p of ps) { try { fs.unlinkSync(p.file); } catch (e) { try { fs.rmSync(p.file, { recursive: true, force: true }); } catch (x) {} } log("rejected " + p.id); }
  console.log("✓ rejected " + ps.map(p => p.id).join(", "));
}
// macOS only, and only when a GUI session can show it (osascript fails
// over SSH). Shown from a detached child so the tick never waits on a
// human; Later/timeout snoozes that exact file version for 4 hours.
function dialog(text, buttons, def) {
  if (!MAC || process.env.AIBOX_DIALOG === "0") return "";
  const script = "display dialog " + JSON.stringify(text) + " with title \"aibox\" buttons {" + buttons.map(b => JSON.stringify(b)).join(",") +
    "} default button " + JSON.stringify(def) + " giving up after 300";
  const r = cp.spawnSync("osascript", ["-e", script], { encoding: "utf8" });
  if (r.status !== 0 || /gave up:true/.test(r.stdout)) return "";
  const m = String(r.stdout).match(/button returned:([^,]*)/); return m ? m[1].trim() : "";
}
function notify(text) {
  if (!MAC || process.env.AIBOX_DIALOG === "0") return;
  cp.spawnSync("osascript", ["-e", "display notification " + JSON.stringify(text) + " with title \"aibox\""]);
}
const snoozeKey = p => p.id + ":" + p.hash;
function snooze(ps) { const s = readJson(SNOOZE, {}); ps.forEach(p => { s[snoozeKey(p)] = now().getTime() + 4 * 3600 * 1000; }); writeJson(SNOOZE, s); }
function pendingToAsk() {
  const s = readJson(SNOOZE, {}), t = now().getTime();
  return proposals().filter(p => !p.error && !(s[snoozeKey(p)] > t));
}
function ask(id, expect) {   // detached child of tick; one dialog at a time
  const lock = path.join(CFG, ".lock-dialog");
  try { fs.mkdirSync(lock); } catch (e) { try { if (Date.now() - fs.statSync(lock).mtimeMs < 10 * 60 * 1000) return; fs.rmdirSync(lock); fs.mkdirSync(lock); } catch (x) { return; } }
  try {
    const p = proposals().find(x => x.id === id); if (!p || p.error) return;
    const same = pendingToAsk().filter(x => x.project === p.project);
    if (same.length > 5) {
      const b = dialog(same.length + " scheduling proposals are waiting from " + path.basename(p.project) + ". Review them with: aibox schedule", ["Reject all", "Later"], "Later");
      if (b === "Reject all") reject(same); else snooze(same);
      return;
    }
    if (p.hash !== expect) return;   // rewritten since the tick looked; next tick re-evaluates
    const b = dialog(describe(p), ["Reject", "Later", "Approve"], "Later");
    if (b === "Approve") approve(p, expect); else if (b === "Reject") reject([p]); else snooze([p]);
  } finally { try { fs.rmdirSync(lock); } catch (e) {} }
}

// ── running ─────────────────────────────────────────────────────
// A pid counts as alive only if it started after this boot (pids recycle).
const bootTime = () => Date.now() - os.uptime() * 1000;
function alive(s) {
  if (!s.pid || !s.started || s.started < bootTime()) return false;
  try { return process.kill(s.pid, 0); } catch (e) { return e.code === "EPERM"; }
}
function runEntry(name) {   // synchronous; spawned detached by tick
  const e = entries().find(x => x.name === name); if (!e) return;
  setState(name, { pid: process.pid, started: Date.now() });
  const fd = fs.openSync(LOG, "a");
  fs.writeSync(fd, "\n" + now().toISOString() + " ▶ " + name + " in " + e.project + "\n");
  const t0 = Date.now();
  const r = cp.spawnSync(AIBOX, ["shell", containerCmd(e)], { cwd: e.project, stdio: ["ignore", fd, fd] });
  const secs = Math.round((Date.now() - t0) / 1000), code = r.status === null ? "signal " + r.signal : r.status;
  fs.writeSync(fd, now().toISOString() + " ■ " + name + " exit " + code + " (" + secs + "s)\n"); fs.closeSync(fd);
  setState(name, { pid: 0, status: code === 0 ? "ok" : "failed (" + code + ")", finished: now().getTime() });
  if (code !== 0) {
    let hint = ""; try { hint = /login expired|not logged in|please run \/login/i.test(fs.readFileSync(LOG, "utf8").slice(-4000)) ? " Login expired — run aibox in any project to log in." : ""; } catch (x) {}
    notify("Scheduled job “" + name + "” failed (exit " + code + ")." + hint + " Details: aibox schedule log");
  }
}
const detach = args => cp.spawn(process.execPath, [__filename, ...args], { detached: true, stdio: "ignore", env: process.env }).unref();
function tick() {
  const lock = path.join(CFG, ".lock-tick");
  try { fs.mkdirSync(lock); } catch (e) {
    try { if (Date.now() - fs.statSync(lock).mtimeMs < 10 * 60 * 1000) return; fs.rmdirSync(lock); fs.mkdirSync(lock); } catch (x) { return; }
  }
  try {
    const t = now(), es = entries();
    for (const e of es) {
      const w = parseWhen(e.when), due = w && lastDue(w, t), s = getState(e.name);
      if (!due || due.getTime() <= (s.last || 0)) continue;
      setState(e.name, { last: t.getTime() });   // before spawning: a crash must not re-fire every minute
      if (alive(s)) { log("skip " + e.name + ": previous run still going (pid " + s.pid + ")"); continue; }
      detach(["run", e.name]);
    }
    // on-start entries: aibox checks a per-boot marker in the container and
    // runs them once; skipped quietly when docker or the container is down.
    for (const project of [...new Set(es.filter(e => e.when === "on-start").map(e => e.project))])
      cp.spawnSync(AIBOX, ["onstart-check"], { cwd: project, stdio: "ignore", timeout: 120000 });
    const p = pendingToAsk()[0]; if (p) detach(["ask", p.id, p.hash]);
  } finally { try { fs.rmdirSync(lock); } catch (e) {} }
}

// ── the every-minute trigger ────────────────────────────────────
// PATH is captured at install time: launchd/cron give a login shell that
// knows nothing of Homebrew or nvm, and the tick needs node, docker, colima.
const PLIST = path.join(os.homedir(), "Library", "LaunchAgents", "dev.aibox.schedule.plist"), MARK = "# aibox-schedule";
const xml = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");
const tickCmd = () => shq(AIBOX) + " schedule tick";
function installed() { return MAC ? fs.existsSync(PLIST) : /aibox-schedule/.test(crontab()); }
function crontab() { const r = cp.spawnSync("crontab", ["-l"], { encoding: "utf8" }); return r.status === 0 ? r.stdout : ""; }
function install() {
  if (MAC) {
    fs.mkdirSync(path.dirname(PLIST), { recursive: true });
    fs.writeFileSync(PLIST, `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.aibox.schedule</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>${xml(tickCmd())}</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>${xml(process.env.PATH || "/usr/local/bin:/usr/bin:/bin")}</string></dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardErrorPath</key><string>${xml(path.join(CFG, "schedule-agent.log"))}</string>
</dict></plist>
`);
    const dom = "gui/" + process.getuid();
    cp.spawnSync("launchctl", ["bootout", dom, PLIST]);
    if (cp.spawnSync("launchctl", ["bootstrap", dom, PLIST]).status !== 0) cp.spawnSync("launchctl", ["load", "-w", PLIST]);
    console.log("✓ scheduler on: launchd runs `aibox schedule tick` every minute (aibox schedule off to stop)");
  } else {
    const lines = crontab().split("\n").filter(l => l && !l.includes(MARK));
    lines.push("* * * * * PATH=" + shq(process.env.PATH || "/usr/local/bin:/usr/bin:/bin") + " /bin/bash -c " + shq(tickCmd()) + " " + MARK);
    const r = cp.spawnSync("crontab", ["-"], { input: lines.join("\n") + "\n" });
    if (r.status !== 0) die("could not install the crontab line; add it yourself: * * * * * /bin/bash -c " + shq(tickCmd()));
    console.log("✓ scheduler on: cron runs `aibox schedule tick` every minute (aibox schedule off to stop)");
  }
}
function uninstall() {
  if (MAC) { cp.spawnSync("launchctl", ["bootout", "gui/" + process.getuid(), PLIST]); try { fs.unlinkSync(PLIST); } catch (e) {} }
  else { const lines = crontab().split("\n").filter(l => l && !l.includes(MARK)); cp.spawnSync("crontab", ["-"], { input: lines.length ? lines.join("\n") + "\n" : "" }); }
  console.log("✓ scheduler off (entries kept; aibox schedule on to resume)");
}

// ── CLI ─────────────────────────────────────────────────────────
function list() {
  const es = entries(), t = now();
  if (!es.length) console.log("No scheduled jobs. Add one from a project dir:  aibox schedule add <name> \"daily 08:00\" claude <prompt-file>");
  for (const e of es) {
    const w = parseWhen(e.when), s = getState(e.name);
    const last = alive(s) ? "running since " + fmt(new Date(s.started)) : s.status ? s.status + " " + fmt(new Date(s.finished)) : "never run";
    console.log(e.name.padEnd(14) + e.when.padEnd(16) + path.basename(e.project).padEnd(20) + (e.kind + " " + e.arg).slice(0, 44).padEnd(46) +
      (w.kind === "on-start" ? "on container start" : "next " + fmt(nextDue(w, t))) + " · " + last);
  }
  const ps = proposals();
  if (ps.length) {
    console.log("\nProposals waiting (aibox schedule approve <name> / reject <name>):");
    for (const p of ps) console.log("  " + p.name.padEnd(14) + (p.error ? "INVALID (" + p.error + ")" : p.when.padEnd(16) + path.basename(p.project).padEnd(20) + p.kind + " " + p.arg));
  }
  if (es.length && !installed()) console.log("\nScheduler is OFF — nothing runs until: aibox schedule on");
}
function main() {
  if (!CFG) die("AIBOX_CFG not set");
  const [cmd, ...a] = process.argv.slice(2);
  switch (cmd || "list") {
    case "list": return list();
    case "add": {
      const [name, when, kind, ...rest] = a;
      if (!name || !when || !kind) die("usage: aibox schedule add <name> \"<when>\" claude <prompt-file> | run \"<command>\"  (from the project directory)");
      addEntry({ name, when, project: process.env.AIBOX_PROJECT, kind, arg: rest.join(" ") }, "added by user");
      return console.log("✓ " + name + ": " + parseWhen(when).text + " in " + process.env.AIBOX_PROJECT);
    }
    case "rm": { const l = entries(); if (!l.some(e => e.name === a[0])) die("no job named " + a[0]); writeJson(REG, l.filter(e => e.name !== a[0])); log("removed " + a[0]); return console.log("✓ removed " + a[0]); }
    case "approve": return approve(findProposal(a[0] || die("usage: aibox schedule approve <name>")));
    case "reject": return reject(a[0] === "all" ? proposals() : [findProposal(a[0] || die("usage: aibox schedule reject <name>|all"))]);
    case "on": return install();
    case "off": return uninstall();
    case "tick": return tick();
    case "run": return runEntry(a[0]);
    case "ask": return ask(a[0], a[1]);
    case "on-start": return installed() && entries().filter(e => e.when === "on-start" && e.project === a[0]).forEach(e => console.log(containerCmd(e)));
    case "log": { let s = ""; try { s = fs.readFileSync(LOG, "utf8"); } catch (e) {} const ls = s.split("\n"); return console.log((a[0] ? ls.filter(l => l.includes(a[0])) : ls).slice(-60).join("\n")); }
    default: die("aibox schedule [list|add|rm|approve|reject|on|off|log]");
  }
}
if (require.main === module) main();
module.exports = { parseWhen, lastDue, nextDue, validate, containerCmd, safeRead };
SCHEDJS
}

# The aibox binary as an absolute path, for launchd and the sessions page
# (env and PATH do not reliably survive open/launchd).
_aibox_bin() {
  command -v aibox 2>/dev/null || realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0"
}

cmd_schedule() {
  mkdir -p "${CONFIG_DIR}/inbox"
  _write_schedule_js
  AIBOX_CFG="$CONFIG_DIR" AIBOX_BIN="$(_aibox_bin)" AIBOX_PROJECT="$PROJECT_DIR" node "${CONFIG_DIR}/schedule.js" "$@"
}

# Pending proposals from containers — a one-line nudge on ordinary runs.
_remind_proposals() {
  local n
  n="$(find "${CONFIG_DIR}/inbox" -mindepth 2 -maxdepth 2 -type f ! -name '.*' 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ "${n:-0}" -gt 0 ]] && _info "${n} scheduling proposal(s) waiting — review with: aibox schedule"
  return 0
}

# ── GPU browser (macOS): a Playwright server on the Mac for sessions ──
# Containers get no GPU (Colima, Docker Desktop and OrbStack pass none
# through), so headless Chromium inside renders WebGL on the CPU. `aibox
# browser` runs a Playwright browser server ON THE MAC as a hidden,
# unprivileged user ("render": own node, own Playwright, own home) inside
# that user's launchd domain (Chrome's Mach services need one). Sessions
# read the ws URL from the read-only ~/.aibox/host/browser.url and connect
# through host.docker.internal; the browser sees that user's files, never yours.
RENDER_USER=render
RENDER_HOME=/var/render
BROWSER_PORT=3145
# The render user's uid — only if the account is the one aibox made (home
# is RENDER_HOME); an unrelated account of the same name is never used.
_render_uid() {
  local uid home
  uid="$(id -u "$RENDER_USER" 2>/dev/null)" || _die "No '${RENDER_USER}' user yet — run: aibox browser"
  home="$(dscl . -read "/Users/${RENDER_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [[ "$home" == "$RENDER_HOME" ]] || _die "A '${RENDER_USER}' account exists but is not aibox's (home: ${home:-unknown}, expected ${RENDER_HOME}). Not touching it."
  printf %s "$uid"
}
# Run a shell string as the render user, in its launchd domain, from its
# home, with its own node first on PATH. sudo asks for your password.
# Launched from / : the caller's cwd is inside a mode-700 home render can't
# enter, and bash complains (getcwd) before its own `cd ~` runs.
_render_sh() {
  local uid; uid="$(_render_uid)"
  ( cd / && sudo launchctl asuser "$uid" sudo -u "$RENDER_USER" -H env "PATH=${RENDER_HOME}/node/bin:/usr/bin:/bin" npm_config_update_notifier=false bash -c "cd ~ && $1" )
}
# Bump when serve.js/share.mjs/README change: the next run rewrites them.
BROWSER_REV=2
SHARE_DIR="${CONFIG_DIR}/share"
# Write stdin to a file in render's home. Plain sudo -u is enough for files
# (only Chrome needs render's launchd domain).
_render_write() { ( cd / && sudo -u "$RENDER_USER" tee "${RENDER_HOME}/$1" >/dev/null ); }
_browser_setup() {
  local auto="${1:-}"
  if ! id -u "$RENDER_USER" >/dev/null 2>&1; then
    _info "Creating hidden user '${RENDER_USER}' (sudo asks for your password)..."
    sudo sysadminctl -addUser "$RENDER_USER" -fullName "aibox render" -shell /bin/zsh -home "$RENDER_HOME" >/dev/null 2>&1 \
      || _die "sysadminctl could not create the user."
    sudo dscl . -create "/Users/${RENDER_USER}" IsHidden 1
  fi
  _render_uid >/dev/null
  sudo mkdir -p "$RENDER_HOME" && sudo chown "${RENDER_USER}:staff" "$RENDER_HOME" && sudo chmod 750 "$RENDER_HOME"
  # Your home is group-readable by default and render is in staff: close it,
  # or the browser could read ~/Projects through file:// URLs.
  if [[ "$(stat -f %Lp "$HOME")" != "700" ]]; then
    _info "Closing ${HOME} to other local users (chmod 700)."
    chmod 700 "$HOME"
  fi
  local arch
  case "$(uname -m)" in arm64) arch=darwin-arm64 ;; *) arch=darwin-x64 ;; esac
  _info "Installing node and Playwright for '${RENDER_USER}' (a few minutes, one time)..."
  _render_sh '[ -x node/bin/node ] || { f=$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt | grep -o "node-v22[^ ]*'"$arch"'.tar.gz" | head -1) && curl -fsSL "https://nodejs.org/dist/latest-v22.x/$f" | tar xz && rm -rf node && mv "${f%.tar.gz}" node; }'
  # Rerunning setup is the update path: always resolve @latest, then fetch
  # the Chromium build that version wants. The agent-socket SDK is only
  # loaded by --share.
  _render_sh '[ -f package.json ] || npm init -y >/dev/null; npm i @playwright/test@latest @agent-socket/sdk@^0.2 >/dev/null && npx playwright install chromium >/dev/null && node -e "console.log(require(\"@playwright/test/package.json\").version)" > .pw-version'
  _browser_files
  if [[ -n "$auto" ]]; then
    _ok "'${RENDER_USER}' is ready (Playwright $(cat "${RENDER_HOME}/.pw-version" 2>/dev/null))."
    return 0
  fi
  _ok "'${RENDER_USER}' is ready (Playwright $(cat "${RENDER_HOME}/.pw-version" 2>/dev/null)). Start the server with: aibox browser"
  _info "Optional, for several sessions rendering at once: give '${RENDER_USER}' a display session (see ${RENDER_HOME}/README.md)."
}
# The files aibox owns in render's home. Rewritten by setup and whenever
# BROWSER_REV moves, so a pulled aibox reaches them without a full setup.
_browser_files() {
  _render_sh '[ -d node_modules/@agent-socket/sdk ] || npm i @agent-socket/sdk@^0.2 >/dev/null'
  _render_write serve.js <<SERVE_JS
// aibox GPU browser server: full Chromium in new-headless mode (Metal via
// ANGLE), one browser shared by all connecting sessions, each in its own
// context. Run by \`aibox browser\` on the Mac (foreground, Ctrl-C stops it).
// Closing the LAST window crashes Chromium when this user has no display
// session (NSWindow close), so the server holds one page open for its
// lifetime; if the browser still exits, it is relaunched on the same URL.
// With AIBOX_SHARE (a relay URL) it also shares a separate, locked-down
// browser through an agent-socket link: see share.mjs.
const { chromium } = require("@playwright/test");
const wsPath = "/" + require("crypto").randomBytes(8).toString("hex");
const fatal = e => { console.error(e); process.exit(1); };
async function serve() {
  // No Playwright signal handlers: they exit the process at once, before
  // share.mjs can end its link. aibox stops everything of render's anyway.
  const s = await chromium.launchServer({ channel: "chromium", headless: true, host: "127.0.0.1", port: ${BROWSER_PORT}, wsPath,
    handleSIGINT: false, handleSIGTERM: false, handleSIGHUP: false });
  console.log("Listening on " + s.wsEndpoint());
  s.on("close", () => { console.log(new Date().toISOString() + " browser exited - relaunching"); setTimeout(() => serve().catch(fatal), 1000); });
  try { const keeper = await chromium.connect(s.wsEndpoint()); await (await keeper.newContext()).newPage(); }
  catch (e) { console.log("keeper page failed: " + e.message); }
}
serve().catch(fatal);
if (process.env.AIBOX_SHARE) {
  import("./share.mjs")
    .then(m => m.start({ chromium, launchOptions: { channel: "chromium" }, relay: process.env.AIBOX_SHARE, playwrightVersion: require("@playwright/test/package.json").version }))
    .catch(e => console.log("share: could not start: " + e.message));
}
SERVE_JS
  _render_write share.mjs <<'AIBOX_SHARE_MJS'
// aibox share: the Mac's GPU browser for agents anywhere, through an
// agent-socket link. Loaded by serve.js when `aibox browser --share` runs.
//
// The boundary is fixed here; everything inside it is free:
// - its own Chromium (not the one containers share), every request forced
//   through the filtering proxy below, which refuses hosts not on the
//   allowlist, IP literals, ports other than 80/443, and any name that
//   resolves to a private, loopback or link-local address (checked on the
//   address it then connects to, so DNS rebinding can't slip through);
// - agent code runs only inside pages (Chromium's sandbox, as `render`);
// - widening (a new host, keeping a tool) needs the user's click: an `ask`
//   line goes to aibox on stdout, the answer comes back on stdin.
// Uploaded files are served at https://app.aibox/ from memory.
import { connect, endSession } from "@agent-socket/sdk";
import http from "node:http";
import net from "node:net";
import dns from "node:dns/promises";
import readline from "node:readline";
import crypto from "node:crypto";

const ORIGIN = "https://app.aibox";
const LIMITS = {
  pages: 8, fileBytes: 64 << 20, files: 2000, imageBytes: 2_800_000, resultChars: 256_000,
  opMs: 25_000, idleMs: 15 * 60_000, tools: 30, askMs: 15 * 60_000, hostsPerAsk: 10, logLines: 100,
};
const HOST_RE = /^(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}$/;
const FILE_RE = /^(?!.*(^|\/)\.\.?(\/|$))[A-Za-z0-9._\-/]{1,256}$/;
const TOOL_RE = /^\/[a-z0-9][a-z0-9_-]{0,63}$/;
const TYPES = {
  html: "text/html", htm: "text/html", js: "text/javascript", mjs: "text/javascript", css: "text/css",
  json: "application/json", map: "application/json", txt: "text/plain", svg: "image/svg+xml",
  png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp",
  avif: "image/avif", ktx2: "image/ktx2", hdr: "application/octet-stream", exr: "application/octet-stream",
  glb: "model/gltf-binary", gltf: "model/gltf+json", bin: "application/octet-stream", wasm: "application/wasm",
  woff2: "font/woff2", woff: "font/woff", ttf: "font/ttf", mp4: "video/mp4", webm: "video/webm",
  mp3: "audio/mpeg", wav: "audio/wav", ogg: "audio/ogg",
};

const out = (line) => process.stdout.write(line + "\n");
// Agent-supplied text (reasons, error messages) reaches the owner's terminal:
// no control characters, so no escape sequences.
const clean = (t) => String(t).replace(/[\u0000-\u0008\u000b-\u001f\u007f-\u009f]/g, "?");
const log = (msg) => out("share: " + clean(msg).replace(/[\r\n]+/g, " | "));
// Events for aibox carry its per-run key, so no other output (an agent's
// error text, Chromium's logs) can pass for one.
const KEY = process.env.AIBOX_SHARE_KEY || "";
const event = (e) => out("@@aibox" + (KEY ? ":" + KEY : "") + " " + e);
const b64 = (s) => Buffer.from(s, "utf8").toString("base64");
const err = (status, code, message, extra = {}) => ({ status, body: { error: { code, message, ...extra } } });
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const withTimeout = (p, ms, what) => Promise.race([p, sleep(ms).then(() => { throw Object.assign(new Error(what + " timed out after " + ms + " ms"), { code: "timeout" }); })]);
function parse(body) {
  if (!body) return {};
  try { const v = JSON.parse(body); return v && typeof v === "object" && !Array.isArray(v) ? v : null; } catch { return null; }
}

// ── network: allowlist + filtering proxy ─────────────────────────────
const allowed = new Set();
const refused = new Map(); // host -> why the proxy refused it (newest 200)
// Separate lists: a BlockList checks IPv4 addresses against IPv6 rules as
// IPv4-mapped, so one ::ffff:0:0/96 rule would refuse every IPv4 address.
const private4 = new net.BlockList(), private6 = new net.BlockList();
for (const [a, p] of [["0.0.0.0", 8], ["10.0.0.0", 8], ["100.64.0.0", 10], ["127.0.0.0", 8], ["169.254.0.0", 16],
  ["172.16.0.0", 12], ["192.0.0.0", 24], ["192.168.0.0", 16], ["198.18.0.0", 15], ["224.0.0.0", 3]]) private4.addSubnet(a, p, "ipv4");
for (const [a, p] of [["::", 127], ["fc00::", 7], ["fe80::", 10], ["ff00::", 8], ["::ffff:0:0", 96],
  ["64:ff9b::", 96], ["2002::", 16], ["2001::", 32]]) private6.addSubnet(a, p, "ipv6");
export const privateAddr = (ip) => net.isIPv4(ip) ? private4.check(ip, "ipv4") : private6.check(ip, "ipv6");

export function hostAllowed(host) {
  const h = host.toLowerCase().replace(/\.$/, "");
  if (allowed.has(h)) return true;
  for (let i = h.indexOf("."); i >= 0; i = h.indexOf(".", i + 1)) if (allowed.has("*" + h.slice(i))) return true;
  return false;
}
export const validHost = (h) => typeof h === "string" && h.length <= 253 && HOST_RE.test(h);

// Reason a connection may not be made, or the address to connect to.
async function vet(host, port) {
  host = (host || "").toLowerCase().replace(/^\[|\]$/g, "").replace(/\.$/, "");
  const deny = (reason) => {
    refused.delete(host); refused.set(host, reason);
    if (refused.size > 200) refused.delete(refused.keys().next().value);
    return { reason };
  };
  if (net.isIP(host)) return deny("IP addresses are never reachable; use a hostname");
  if (port !== 443 && port !== 80) return deny("only ports 80 and 443");
  if (!hostAllowed(host)) return deny("not allowed yet; ask with POST /request");
  let addrs;
  try { addrs = await dns.lookup(host, { all: true, verbatim: true }); } catch { return deny("does not resolve"); }
  if (!addrs.length) return deny("does not resolve");
  for (const a of addrs) if (privateAddr(a.address)) return deny("resolves to a private address");
  return { address: addrs[0].address, host };
}

function startProxy() {
  const server = http.createServer(async (req, res) => {
    let u;
    try { u = new URL(req.url); } catch { res.writeHead(400).end(); return; }
    if (u.protocol !== "http:") { res.writeHead(400).end(); return; }
    const v = await vet(u.hostname, Number(u.port || 80));
    if (v.reason) { res.writeHead(403, { "content-type": "text/plain", "x-aibox-blocked": "1" }).end("aibox: " + u.hostname + ": " + v.reason); return; }
    const headers = { ...req.headers, host: u.host };
    delete headers["proxy-connection"]; delete headers["proxy-authorization"];
    const up = http.request({ host: v.address, port: Number(u.port || 80), method: req.method, path: u.pathname + u.search, headers }, (r) => {
      res.writeHead(r.statusCode, r.headers); r.pipe(res);
    });
    up.on("error", () => res.destroy());
    req.pipe(up);
  });
  server.on("connect", async (req, sock, head) => {
    sock.on("error", () => {});
    const i = req.url.lastIndexOf(":");
    const v = await vet(req.url.slice(0, i), Number(req.url.slice(i + 1)));
    if (v.reason) { sock.end("HTTP/1.1 403 Forbidden\r\n\r\n"); return; }
    const up = net.connect(Number(req.url.slice(i + 1)), v.address, () => {
      sock.write("HTTP/1.1 200 Connection Established\r\n\r\n");
      if (head?.length) up.write(head);
      up.pipe(sock); sock.pipe(up);
    });
    up.on("error", () => sock.destroy());
    sock.on("close", () => up.destroy());
  });
  return new Promise((resolve) => server.listen(0, "127.0.0.1", () => resolve(server)));
}

// ── files served at https://app.aibox/ ───────────────────────────────
const files = new Map(); // path -> { buf, type }
let fileBytes = 0;
const typeOf = (p) => TYPES[(p.split(".").pop() || "").toLowerCase()] || "application/octet-stream";
function putFile(f) {
  if (!f || typeof f.path !== "string" || !FILE_RE.test(f.path.replace(/^\/+/, ""))) return "bad path (letters, digits, . _ - /; no ..)";
  if (typeof f.data !== "string") return "data must be a string";
  const path = f.path.replace(/^\/+/, "");
  const enc = f.encoding === "base64" ? "base64" : "utf8";
  const chunk = Buffer.from(f.data, enc);
  const prev = files.get(path);
  const buf = f.append && prev ? Buffer.concat([prev.buf, chunk]) : chunk;
  const next = fileBytes - (prev?.buf.length || 0) + buf.length;
  if (next > LIMITS.fileBytes) return "over the " + (LIMITS.fileBytes >> 20) + " MiB total for files";
  if (!prev && files.size >= LIMITS.files) return "too many files";
  const type = typeof f.content_type === "string" && /^[\w.+-]+\/[\w.+-]+$/.test(f.content_type) ? f.content_type : (prev && f.append ? prev.type : typeOf(path));
  files.set(path, { buf, type });
  fileBytes = next;
  return { path, bytes: buf.length };
}
async function serveFile(route) {
  let p = decodeURIComponent(new URL(route.request().url()).pathname).replace(/^\/+/, "");
  if (p === "" || p.endsWith("/")) p += "index.html";
  const f = files.get(p);
  if (!f) return route.fulfill({ status: 404, contentType: "text/plain", body: "not uploaded: " + p });
  return route.fulfill({ status: 200, contentType: f.type, body: f.buf, headers: { "cache-control": "no-store", "access-control-allow-origin": "*" } });
}

// ── browser and pages ────────────────────────────────────────────────
let browser = null, gpuInfo = null, proxyPort = 0, chromiumRef = null, launchOpts = {}, stopping = false;
const pages = new Map(); // id -> { ctx, page, logs: [], last }
async function launch() {
  browser = await chromiumRef.launch({
    ...launchOpts, headless: true,
    // Playwright's own handlers would exit the process before stop() can
    // end the link; stop() closes this browser itself.
    handleSIGINT: false, handleSIGTERM: false, handleSIGHUP: false,
    args: [...(launchOpts.args || []),
      "--proxy-server=http://127.0.0.1:" + proxyPort, "--proxy-bypass-list=<-loopback>",
      "--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE 127.0.0.1",
      "--force-webrtc-ip-handling-policy=disable_non_proxied_udp", "--webrtc-ip-handling-policy=disable_non_proxied_udp"],
  });
  // Same crash guard as serve.js: never let the last window close.
  await (await browser.newContext()).newPage().catch(() => {});
  browser.on("disconnected", () => {
    pages.clear(); browser = null;
    if (stopping) return;
    log("browser exited - relaunching (open pages are gone)");
    setTimeout(() => launch().catch((e) => log("relaunch failed: " + e.message)), 1000);
  });
}
const ready = async () => { for (let i = 0; !browser && i < 50; i++) await sleep(100); if (!browser) throw Object.assign(new Error("browser is restarting"), { code: "unavailable" }); return browser; };

// Console output and blocked hosts since the last call, for this page.
function report(p) {
  const r = {};
  if (p?.logs.length) r.console = p.logs.splice(0);
  if (p?.blocked.size) {
    r.blocked = [...p.blocked].map(([host, reason]) => ({ host, reason }));
    r.hint = "Blocked hosts: upload what you need with POST /files (served at " + ORIGIN + "/), or ask for the host with POST /request.";
    p.blocked.clear();
  }
  return r;
}
function pageOf(id) {
  const p = pages.get(id);
  if (!p) throw Object.assign(new Error("no page " + JSON.stringify(id) + " (open pages: " + ([...pages.keys()].join(", ") || "none") + ")"), { code: "no_page" });
  p.last = Date.now();
  return p;
}
async function openPage(a) {
  if (pages.size >= LIMITS.pages) throw Object.assign(new Error("at most " + LIMITS.pages + " pages; close some with POST /close"), { code: "too_many_pages" });
  const target = new URL(typeof a.url === "string" && a.url ? a.url : "index.html", ORIGIN + "/");
  if (!/^https?:$/.test(target.protocol)) throw Object.assign(new Error("only http(s) URLs"), { code: "bad_url" });
  if (target.origin !== ORIGIN && !hostAllowed(target.hostname)) {
    throw Object.assign(new Error(target.hostname + " is not allowed yet: upload the page with POST /files and open it by path, or POST /request for the host"), { code: "host_not_allowed" });
  }
  const w = Math.min(Math.max(a.width | 0 || 1280, 16), 4096), h = Math.min(Math.max(a.height | 0 || 720, 16), 4096);
  const scale = Math.min(Math.max(Number(a.scale) || 1, 0.25), 3);
  const ctx = await (await ready()).newContext({ viewport: { width: w, height: h }, deviceScaleFactor: scale, serviceWorkers: "block", acceptDownloads: false });
  await ctx.route(ORIGIN + "/**", serveFile);
  const page = await ctx.newPage();
  const id = crypto.randomBytes(3).toString("hex");
  const rec = { ctx, page, logs: [], blocked: new Map(), last: Date.now() };
  const block = (url) => { let h = ""; try { h = new URL(url).hostname.replace(/^\[|\]$/g, ""); } catch {} rec.blocked.set(h, refused.get(h) || "blocked"); };
  const push = (s) => { if (rec.logs.length < LIMITS.logLines) rec.logs.push(s.slice(0, 500)); };
  page.on("console", (m) => push(m.type() + ": " + m.text()));
  page.on("pageerror", (e) => push("pageerror: " + (e.stack || e.message)));
  page.on("requestfailed", (r) => {
    const why = r.failure()?.errorText || "";
    if (/TUNNEL_CONNECTION_FAILED|NAME_NOT_RESOLVED/.test(why)) block(r.url());
    else push("requestfailed: " + r.url().slice(0, 200) + " " + why);
  });
  page.on("response", (r) => { if (r.status() === 403 && r.headers()["x-aibox-blocked"]) block(r.url()); });
  pages.set(id, rec);
  const wait = ["load", "domcontentloaded", "networkidle", "commit"].includes(a.wait) ? a.wait : "load";
  const resp = await page.goto(target.href, { waitUntil: wait, timeout: LIMITS.opMs - 2000 }).catch((e) => { push("goto: " + e.message.split("\n")[0]); return null; });
  return { page: id, url: target.href, http_status: resp?.status() ?? null, viewport: { width: w, height: h, scale } };
}
async function closePage(id) {
  const p = pages.get(id);
  if (!p) return false;
  pages.delete(id);
  await p.ctx.close().catch(() => {});
  return true;
}
setInterval(() => { for (const [id, p] of pages) if (Date.now() - p.last > LIMITS.idleMs) closePage(id); }, 60_000).unref();

function serialize(v) {
  const s = JSON.stringify(v === undefined ? null : v);
  return s.length > LIMITS.resultChars ? { result_truncated: s.slice(0, LIMITS.resultChars) } : { result: JSON.parse(s) };
}
async function evalIn(p, js, arg) {
  if (typeof js !== "string" || !js.trim()) throw Object.assign(new Error("js must be the body of an async function; return a JSON value"), { code: "bad_js" });
  // A string expression runs through CDP, so a page's own CSP can't block it.
  return withTimeout(p.page.evaluate("(async (arg) => {\n" + js + "\n})(" + JSON.stringify(arg ?? null) + ")"), LIMITS.opMs - 2000, "js");
}
async function shoot(p, a = {}) {
  const frames = Math.min(Math.max(a.frames ?? 2, 0), 120);
  if (frames) await withTimeout(p.page.evaluate((n) => new Promise((r) => { const f = () => (--n <= 0 ? r() : requestAnimationFrame(f)); requestAnimationFrame(f); }), frames), 10_000, "frames").catch(() => {});
  const type = a.type === "jpeg" ? "jpeg" : "png";
  const opts = { type, fullPage: !!a.full_page, omitBackground: !!a.omit_background && type === "png", timeout: LIMITS.opMs - 5000 };
  if (type === "jpeg") opts.quality = Math.min(Math.max(a.quality | 0 || 85, 1), 100);
  if (a.clip && typeof a.clip === "object") opts.clip = { x: +a.clip.x || 0, y: +a.clip.y || 0, width: +a.clip.width || 1, height: +a.clip.height || 1 };
  const buf = typeof a.selector === "string" ? await p.page.locator(a.selector).first().screenshot(opts) : await p.page.screenshot(opts);
  if (buf.length > LIMITS.imageBytes) {
    throw Object.assign(new Error("image is " + buf.length + " bytes, over " + LIMITS.imageBytes + ": use type jpeg, a lower quality, a clip/selector or a smaller viewport/scale"), { code: "image_too_large" });
  }
  return { type, bytes: buf.length, data: buf.toString("base64") };
}
async function gpu() {
  if (gpuInfo) return gpuInfo;
  const ctx = await (await ready()).newContext();
  try {
    const page = await ctx.newPage();
    gpuInfo = await withTimeout(page.evaluate(async () => {
      const c = document.createElement("canvas"), gl = c.getContext("webgl2") || c.getContext("webgl");
      const ext = gl && gl.getExtension("WEBGL_debug_renderer_info");
      let webgpu = null;
      try { const ad = navigator.gpu && await navigator.gpu.requestAdapter(); webgpu = ad ? (ad.info ? { vendor: ad.info.vendor, architecture: ad.info.architecture } : true) : false; } catch { webgpu = false; }
      return { webgl: gl ? (gl instanceof WebGL2RenderingContext ? 2 : 1) : 0, renderer: ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : (gl ? gl.getParameter(gl.RENDERER) : null), webgpu };
    }), 10_000, "gpu probe");
  } finally { await ctx.close().catch(() => {}); }
  return gpuInfo;
}

// ── approvals (stdout `@@aibox ask`, stdin `answer`) ─────────────────
const asks = new Map(); // id -> { kind, hosts?, tool?, taskId?, timer }
let session = null;
function ask(kind, text, extra) {
  const id = crypto.randomBytes(3).toString("hex");
  const a = { kind, ...extra };
  a.timer = setTimeout(() => answer(id, "timeout"), LIMITS.askMs);
  asks.set(id, a);
  event("ask " + id + " " + kind + " " + b64(text) + (a.hosts ? " " + a.hosts.join(" ") : ""));
  return id;
}
function answer(id, choice) {
  const a = asks.get(id);
  if (!a) return log("no pending request " + id);
  asks.delete(id); clearTimeout(a.timer);
  event("done " + id);
  const yes = choice === "allow" || choice === "always";
  if (a.kind === "hosts") {
    if (yes) for (const h of a.hosts) allowed.add(h);
    if (choice === "always") event("persist-hosts " + a.hosts.join(" "));
    log((yes ? "allowed " : "refused ") + a.hosts.join(", ") + (choice === "always" ? " (always)" : yes ? " (this session)" : choice === "timeout" ? " (no answer)" : ""));
    // Throws while the relay link is down; the agent's poll then just never completes.
    try { session?.completeTask(a.taskId, { body: { approved: yes, answer: choice, hosts: a.hosts, allowed_hosts: [...allowed] } }); }
    catch (e) { log("could not tell the agent: " + e.message); }
  } else if (a.kind === "keep") {
    if (choice === "always") { event("persist-tool " + a.tool.path.slice(1) + " " + b64(JSON.stringify(a.tool))); log("kept tool " + a.tool.path); }
    else log("tool " + a.tool.path + " stays for this session only");
  }
}

// ── agent-defined tools (run in pages, so no approval to define) ─────
const defined = new Map(); // path -> def
function validTool(d) {
  if (!d || typeof d !== "object") return "body must be an object";
  if (typeof d.path !== "string" || !TOOL_RE.test(d.path)) return "path must look like /orbit_shots (a-z 0-9 _ -)";
  if (builtins.some((t) => t.path === d.path || t.path.startsWith(d.path + "/"))) return d.path + " is a built-in";
  if (typeof d.description !== "string" || !d.description.trim() || d.description.length > 4000) return "description: 1-4000 characters";
  if (typeof d.js !== "string" || !d.js.trim() || d.js.length > 32_000) return "js: the body of an async function, at most 32000 characters";
  if (d.input_schema !== undefined && (typeof d.input_schema !== "object" || JSON.stringify(d.input_schema).length > 16_000)) return "input_schema: a JSON Schema object";
  if (d.url !== undefined && typeof d.url !== "string") return "url must be a string";
  if (!defined.has(d.path) && defined.size >= LIMITS.tools) return "at most " + LIMITS.tools + " defined tools";
  return null;
}
const pick = (d) => ({ path: d.path, description: d.description, js: d.js, input_schema: d.input_schema, url: d.url, width: d.width, height: d.height, scale: d.scale, wait: d.wait, screenshot: d.screenshot });
function definedTool(d) {
  return {
    path: d.path, description: d.description + "\n\n(Agent-defined. Body: your arguments as JSON, passed to the tool's js as `arg`; add \"page\": \"<id>\" to run in an open page instead of a fresh one.)",
    input_schema: d.input_schema || { type: "object" },
    handler: guard(d.path, async (a) => {
      let id = typeof a.page === "string" ? a.page : null, opened = false;
      if (id) pageOf(id); else { id = (await openPage({ url: d.url, width: d.width, height: d.height, scale: d.scale, wait: d.wait })).page; opened = true; }
      try {
        const p = pageOf(id);
        const r = serialize(await evalIn(p, d.js, a));
        if (d.screenshot) r.image = await shoot(p, typeof d.screenshot === "object" ? d.screenshot : {});
        return { ...r, ...(opened ? {} : { page: id }), ...report(p) };
      } finally { if (opened) await closePage(id); }
    }),
  };
}
function define(d, quiet) {
  const why = validTool(d);
  if (why) return why;
  defined.set(d.path, pick(d));
  if (!quiet) log("tool " + d.path + " defined");
  return null;
}
const toolList = () => [...builtins, ...[...defined.values()].map(definedTool)];
let syncing = Promise.resolve();
const syncTools = () => (syncing = syncing.then(() => session?.updateTools(toolList(), agentsMd())).catch((e) => log("tool update failed: " + e.message)));

// Every handler: parse, log one line, map thrown errors to HTTP answers.
function guard(name, fn) {
  return async ({ body }) => {
    const a = parse(body);
    if (!a) return err(400, "bad_json", "the body must be a JSON object");
    const t = Date.now();
    try {
      const r = await fn(a);
      log(name + " (" + (Date.now() - t) + " ms)");
      return r;
    } catch (e) {
      log(name + " failed: " + e.message.split("\n")[0]);
      const status = { no_page: 404, too_many_pages: 429, host_not_allowed: 403, image_too_large: 413, timeout: 504, unavailable: 503 }[e.code] || 400;
      return err(status, e.code || "failed", e.message.split("\n").slice(0, 3).join(" "), report(null));
    }
  };
}

const builtins = [
  { method: "GET", path: "/info", description: "GPU (WebGL renderer, WebGPU), Chromium and Playwright versions, allowed hosts, open pages, uploaded files, limits and agent-defined tools.",
    handler: guard("info", async () => ({
      gpu: await gpu(), chromium: (await ready()).version(), playwright: PW, origin: ORIGIN,
      allowed_hosts: [...allowed], pages: [...pages.keys()], files: { count: files.size, bytes: fileBytes },
      tools: [...defined.keys()], limits: LIMITS,
    })) },
  { path: "/files", description: "Upload files, served at " + ORIGIN + "/<path> to pages opened here. Body: {\"files\": [{\"path\": \"index.html\", \"data\": \"...\", \"encoding\": \"utf8\" | \"base64\", \"append\": false, \"content_type\": optional}]}. A request body is at most 1 MiB, so send big files in base64 pieces with append: true. Content type comes from the extension.",
    input_schema: { type: "object", required: ["files"], properties: { files: { type: "array", items: { type: "object", required: ["path", "data"], properties: {
      path: { type: "string" }, data: { type: "string" }, encoding: { enum: ["utf8", "base64"] }, append: { type: "boolean" }, content_type: { type: "string" } } } } } },
    handler: guard("files", async (a) => {
      if (!Array.isArray(a.files) || !a.files.length) throw Object.assign(new Error("files: a non-empty array"), { code: "bad_files" });
      const stored = [], errors = [];
      for (const f of a.files) { const r = putFile(f); typeof r === "string" ? errors.push({ path: f?.path, error: r }) : stored.push(r); }
      return { stored, errors, total: { count: files.size, bytes: fileBytes } };
    }) },
  { method: "GET", path: "/files", description: "List uploaded files with sizes.",
    handler: guard("files list", async () => ({ files: [...files].map(([path, f]) => ({ path, bytes: f.buf.length, type: f.type })), bytes: fileBytes })) },
  { path: "/files/delete", description: "Delete uploaded files. Body: {\"paths\": [...]} or {\"all\": true}.",
    handler: guard("files delete", async (a) => {
      const ps = a.all ? [...files.keys()] : Array.isArray(a.paths) ? a.paths : [];
      for (const p of ps) { const f = files.get(p); if (f) { fileBytes -= f.buf.length; files.delete(p); } }
      return { deleted: ps.length, total: { count: files.size, bytes: fileBytes } };
    }) },
  { path: "/page", description: "Open a page in a fresh, isolated context. Body: {\"url\": \"index.html\" (a path under " + ORIGIN + "/, or an https URL on an allowed host), \"width\": 1280, \"height\": 720, \"scale\": 1, \"wait\": \"load\" | \"domcontentloaded\" | \"networkidle\"}. Returns the page id, plus console output and blocked hosts so far.",
    input_schema: { type: "object", properties: { url: { type: "string" }, width: { type: "integer" }, height: { type: "integer" }, scale: { type: "number" }, wait: { type: "string" } } },
    handler: guard("page", async (a) => { const r = await openPage(a); return { ...r, ...report(pages.get(r.page)) }; }) },
  { path: "/eval", description: "Run JavaScript in a page. Body: {\"page\": \"<id>\", \"js\": \"<body of an async function>\", \"arg\": <any JSON>}. Use `return` to send back a JSON value (truncated past 256k characters). Also returns console output since the last call.",
    input_schema: { type: "object", required: ["page", "js"], properties: { page: { type: "string" }, js: { type: "string" }, arg: {} } },
    handler: guard("eval", async (a) => { const p = pageOf(a.page); return { ...serialize(await evalIn(p, a.js, a.arg)), ...report(p) }; }) },
  { path: "/screenshot", description: "Screenshot a page after `frames` animation frames (default 2). Body: {\"page\": \"<id>\", \"type\": \"png\" | \"jpeg\", \"quality\": 85, \"full_page\": false, \"selector\": optional, \"clip\": {x,y,width,height} optional, \"omit_background\": false, \"frames\": 2}. Returns {type, bytes, data} with data in base64 (e.g. `jq -r .data | base64 -d > shot.png`). Images over ~2.8 MB are refused: use jpeg or a smaller clip.",
    input_schema: { type: "object", required: ["page"], properties: { page: { type: "string" }, type: { enum: ["png", "jpeg"] }, quality: { type: "integer" }, full_page: { type: "boolean" }, selector: { type: "string" }, clip: { type: "object" }, omit_background: { type: "boolean" }, frames: { type: "integer" } } },
    handler: guard("screenshot", async (a) => { const p = pageOf(a.page); return { ...(await shoot(p, a)), ...report(p) }; }) },
  { path: "/close", description: "Close a page. Body: {\"page\": \"<id>\"} or {\"all\": true}. Idle pages close after 15 minutes anyway.",
    handler: guard("close", async (a) => {
      const ids = a.all ? [...pages.keys()] : [a.page];
      let n = 0; for (const id of ids) if (await closePage(id)) n++;
      return { closed: n, pages: [...pages.keys()] };
    }) },
  { path: "/request", description: "Ask the user to let pages reach more hosts (a CDN, an API). Body: {\"hosts\": [\"cdn.jsdelivr.net\", \"*.example.com\"], \"reason\": \"one line the user will see\"}. The user gets a dialog on their Mac; this returns 202 with a taskId: poll <link base>/_as_tasks/<taskId> every few seconds until it answers {approved, allowed_hosts}. Uploading what you need with /files needs no approval.",
    input_schema: { type: "object", required: ["hosts", "reason"], properties: { hosts: { type: "array", items: { type: "string" } }, reason: { type: "string" } } },
    handler: guard("request", async (a) => {
      const hosts = Array.isArray(a.hosts) ? [...new Set(a.hosts.map((h) => String(h).toLowerCase()))] : [];
      const bad = hosts.filter((h) => !validHost(h));
      if (!hosts.length || hosts.length > LIMITS.hostsPerAsk || bad.length) {
        throw Object.assign(new Error("hosts: 1-" + LIMITS.hostsPerAsk + " hostnames like cdn.jsdelivr.net or *.example.com" + (bad.length ? " (bad: " + bad.join(", ") + ")" : "")), { code: "bad_hosts" });
      }
      // A plain host a wildcard already covers isn't missing; a wildcard is
      // missing unless that exact wildcard was granted.
      const missing = hosts.filter((h) => !allowed.has(h) && (h.startsWith("*.") || !hostAllowed(h)));
      if (!missing.length) return { approved: true, answer: "already", allowed_hosts: [...allowed] };
      const reason = clean(String(a.reason || "").replace(/\s+/g, " ").trim()).slice(0, 300) || "(no reason given)";
      const taskId = crypto.randomUUID();
      const id = ask("hosts", "A remote agent asks to let the shared browser reach:\n\n  " + missing.join("\n  ") + "\n\nIts reason: " + reason, { hosts: missing, taskId });
      log("request " + id + ": " + missing.join(", ") + " - " + reason);
      return { status: 202, taskId };
    }) },
  { path: "/define", description: "Add your own tool to this link, live: it opens a fresh page at `url` (default index.html), runs `js` with your call's body as `arg`, optionally screenshots, and closes the page. Body: {\"path\": \"/orbit_shots\", \"description\": \"...\", \"js\": \"<body of an async function>\", \"input_schema\": optional, \"url\": optional, \"width\"/\"height\"/\"scale\"/\"wait\": optional, \"screenshot\": false | true | {screenshot options}, \"keep\": false}. Re-fetch the tool list afterwards. Defining needs no approval; keep: true asks the user to keep it for future sessions. Redefining a path replaces it.",
    input_schema: { type: "object", required: ["path", "description", "js"], properties: { path: { type: "string" }, description: { type: "string" }, js: { type: "string" }, input_schema: { type: "object" }, url: { type: "string" }, screenshot: {}, keep: { type: "boolean" } } },
    handler: guard("define", async (a) => {
      const why = define(a);
      if (why) throw Object.assign(new Error(why), { code: "bad_tool" });
      await syncTools();
      let keep = null;
      if (a.keep) { keep = "asked the user"; ask("keep", "A remote agent asks to keep its tool " + a.path + " for future shared sessions:\n\n" + clean(a.description.slice(0, 600)), { tool: pick(a) }); }
      return { defined: a.path, keep, tools: [...defined.keys()] };
    }) },
  { path: "/undefine", description: "Remove an agent-defined tool for this session. Body: {\"path\": \"/orbit_shots\"}.",
    handler: guard("undefine", async (a) => { const had = defined.delete(a.path); if (had) await syncTools(); return { removed: had, tools: [...defined.keys()] }; }) },
];

let PW = null;
function agentsMd() {
  return `# GPU browser on a Mac (aibox)

A real Chromium with the Mac's GPU (Metal), shared with you by its owner. Use it to render WebGL/WebGPU (three.js and the like) and get screenshots back.

Typical flow:
1. \`GET /info\` - GPU, versions, what is allowed.
2. \`POST /files\` - upload your page and assets; they are served at ${ORIGIN}/<path>. Bundle or inline your libraries: pages can reach no other host unless the owner allows it.
3. \`POST /page\` with {"url": "index.html"} - opens it, returns a page id.
4. \`POST /eval\` to drive the scene, \`POST /screenshot\` to get an image (base64 in \`data\`).
5. \`POST /close\` when done.

Network: pages reach only ${ORIGIN}/ (your uploads) and hosts the owner allowed${allowed.size ? " (now: " + [...allowed].join(", ") + ")" : " (none yet)"}. Private and local network addresses are never reachable. Blocked requests are listed under \`blocked\` in the next reply. To use a CDN or API, \`POST /request\` with the hosts and a one-line reason, then poll the returned task until the owner answers.

Your own tools: \`POST /define\` turns a page script into a tool on this same link (no approval needed); re-fetch the tool list after.
${defined.size ? "\nAgent-defined tools now: " + [...defined.keys()].join(", ") + "\n" : ""}
Limits: request bodies 1 MiB (upload big files in base64 pieces with append), images about 2.8 MB, ${LIMITS.pages} open pages, calls time out after about ${Math.round(LIMITS.opMs / 1000)} s, idle pages close after 15 minutes. The link stops working when the owner stops sharing.
`;
}

// ── start ────────────────────────────────────────────────────────────
export async function start({ chromium, launchOptions = {}, relay, playwrightVersion = null, input = process.stdin }) {
  chromiumRef = chromium; launchOpts = launchOptions; PW = playwrightVersion;
  proxyPort = (await startProxy()).address().port;
  // Control lines from aibox: hello | allow <host> | tool <base64 json> | answer <id> <choice>
  readline.createInterface({ input }).on("line", (line) => { try {
    const [cmd, x, y] = line.trim().split(/\s+/);
    if (cmd === "hello") event("ctl-ok");
    else if (cmd === "allow" && validHost(x)) allowed.add(x);
    else if (cmd === "tool" && x) {
      let d = null; try { d = JSON.parse(Buffer.from(x, "base64").toString("utf8")); } catch {}
      const why = define(d, true); if (why) log("saved tool skipped: " + why); else syncTools();
    } else if (cmd === "answer" && x) answer(x, ["allow", "always", "deny"].includes(y) ? y : "deny");
  } catch (e) { log("control line failed: " + e.message); } });
  await launch();
  session = await connect({
    baseUrl: relay, appId: "aibox-gpu-browser", appDescription: "Chromium with the Mac's GPU, for WebGL/WebGPU renders",
    agentsMd: agentsMd(), tools: toolList(),
    onSessionChanged: ({ tokensRemapped }) => { for (const url of Object.values(tokensRemapped || {})) event("link " + url); },
  });
  await syncTools();
  const link = await session.mintAgentToken({ label: "aibox" });
  event("link " + link.url);
  // Ctrl-C and aibox's cleanup both signal us: end the session once, and
  // make sure the relay heard it. close() only starts the socket's close, and
  // exiting right after can drop the frame, leaving the link held (503) for
  // the relay's grace period instead of dead; endSession confirms.
  const stop = async () => {
    if (stopping) return;
    stopping = true;
    const held = { baseUrl: relay, sessionId: session.sessionId, secret: session.resumeSecret };
    session.close();
    if (held.secret) await withTimeout(endSession(held), 3000, "end").catch(() => {});
    await withTimeout(browser?.close() ?? Promise.resolve(), 3000, "browser close").catch(() => {});
    process.exit(0);
  };
  for (const sig of ["SIGTERM", "SIGINT", "SIGHUP"]) process.on(sig, stop);
  return { session, link };
}
AIBOX_SHARE_MJS
  _render_write README.md <<'EOF'
# render - GPU browser server for aibox sessions
Hidden, unprivileged macOS account created by `aibox browser`. No login
password; used only via sudo. Its one job: run a Playwright browser server on
the Mac so sandboxed aibox sessions (Docker in Colima) can render WebGL/WebGPU
with the real GPU instead of SwiftShader.
Why a separate user: a Playwright browser can open file:// and read whatever
its account can read. As render it sees /var/render and system files, never
the home of the person running aibox (which setup makes chmod 700).
Everything here is private to this account: node/ (official tarball),
node_modules/ (Playwright, agent-socket SDK), serve.js (the server),
share.mjs (`aibox browser --share`), .pw-version, .aibox-rev.
Run:  aibox browser   (foreground, output on screen, Ctrl-C stops it)
      aibox browser --share   (also prints a link for agents anywhere)
It must run in its own launchd domain (sudo launchctl asuser <uid> ...),
which aibox does; a plain sudo -u render makes Chrome die at startup.
By hand:  cd / && sudo launchctl asuser $(id -u render) sudo -u render -H env PATH=/var/render/node/bin:/usr/bin:/bin bash -c "cd ~ && node serve.js"
Clients send the header Host: 127.0.0.1:3145 (anything else gets 403).
Without a display session for this user, closing a page crashes Chromium
(NSWindow close with no display); serve.js relaunches it on the same URL.
For concurrent sessions, give it a display session once: set a password
  PW=$(openssl rand -base64 18); sudo sysadminctl -resetPasswordFor render -newPassword "$PW"; sudo dscl . -create /Users/render IsHidden 0; echo "$PW"
then log in as "aibox render" via Fast User Switching and switch back.
Update Playwright:  aibox browser setup   (reinstalls to latest)
Remove everything:  stop the server (Ctrl-C), then
  sudo sysadminctl -deleteUser render; sudo rm -rf /var/render
EOF
  printf '%s\n' "$BROWSER_REV" | _render_write .aibox-rev
}
# Runs only for the invocation whose server came up (BROWSER_UP): a second
# `aibox browser` that lost the port race must not kill the first one.
_browser_cleanup() {
  [[ -n "${BROWSER_UP:-}" ]] || return 0
  rm -f "${CONFIG_DIR}/host/browser.url"
  # Everything of render's: the node server and the Chromium it launched
  # (the user exists for nothing else).
  pgrep -u "$RENDER_USER" >/dev/null 2>&1 && sudo pkill -u "$RENDER_USER" 2>/dev/null || true
}

# ── Sharing (--share): the same browser for agents anywhere ──────────
# share.mjs (in render's home) holds an agent-socket link and enforces the
# boundary. This side owns what persists and every approval: share.mjs
# writes `@@aibox:<per-run key> <event>` lines to stdout (only lines with
# the key count, so agent text echoed in logs can't fake one), and reads `allow <host>`,
# `tool <base64 json>` and `answer <id> <allow|always|deny>` on its stdin, a
# FIFO (~/.aibox/browser.ctl) that `aibox browser answer` can also write to.
# Persistent state is plain files you can edit: ~/.aibox/share/allow (one
# host per line) and ~/.aibox/share/tools/<name>.json.
_valid_host() {
  local re='^(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}$'
  [[ ${#1} -le 253 && "$1" =~ $re ]]
}
_b64d() { printf %s "$1" | base64 -D 2>/dev/null || printf %s "$1" | base64 -d; }
_share_preload() {
  echo hello
  local h f
  if [[ -f "${SHARE_DIR}/allow" ]]; then
    while IFS= read -r h || [[ -n "$h" ]]; do
      h="${h%%#*}"; h="${h//[[:space:]]/}"
      [[ -n "$h" ]] || continue
      if _valid_host "$h"; then echo "allow $h"; else echo "share: skipping '${h}' in ${SHARE_DIR}/allow (not a hostname)" >&2; fi
    done < "${SHARE_DIR}/allow"
  fi
  for f in "${SHARE_DIR}"/tools/*.json; do
    [[ -f "$f" ]] && echo "tool $(base64 < "$f" | tr -d '\n')"
  done
  return 0
}
# Kill a background dialog and everything under it (the osascript sits two
# levels down, inside the $(...)). Kids are listed before the parent dies so
# none is orphaned. Usually it already exited: never let set -e see that.
_share_kill() {
  local kids c
  kids="$(pgrep -P "$1" 2>/dev/null || true)"
  kill "$1" 2>/dev/null || true
  for c in $kids; do _share_kill "$c"; done
}
_share_cleanup() {
  local d
  for d in ${SHARE_DIALOGS:-}; do _share_kill "${d#*:}"; done
  [[ -n "${SHARE_PRELOAD:-}" ]] && _share_kill "$SHARE_PRELOAD"
  exec 3>&- 2>/dev/null || true
  rm -f "${CONFIG_DIR}/browser.ctl"
}
# One dialog per request, in the background so the server's output keeps
# flowing. No GUI (ssh) → no answer here; `aibox browser answer` still works.
_share_dialog() {
  local id="$1" kind="$2" text="$3" buttons dflt cancel r c
  if [[ "$kind" == hosts ]]; then
    buttons='{"Deny", "Allow this session", "Always allow"}'; dflt="Allow this session"; cancel="Deny"
  else
    buttons='{"Session only", "Keep"}'; dflt="Keep"; cancel="Session only"
  fi
  r="$(osascript -e 'on run argv' \
    -e "display dialog (item 1 of argv) with title \"aibox shared browser\" buttons ${buttons} default button \"${dflt}\" cancel button \"${cancel}\" with icon caution giving up after 600" \
    -e 'end run' "$text" 2>&1)" || true
  case "$r" in
    *"gave up:true"*|*"(-128)"*) c=deny ;;
    *"Always allow"*|*"returned:Keep"*) c=always ;;
    *"Allow this session"*) c=allow ;;
    *) return 0 ;;
  esac
  echo "answer ${id} ${c}" >&3 2>/dev/null || true
}
_share_event() {
  local ev=() name
  read -r -a ev <<< "$1"
  case "${ev[0]:-}" in
    ctl-ok) SHARE_CTL=1 ;;
    link)
      [[ "${ev[1]:-}" == https://* ]] || return 0
      echo
      _ok "Sharing. Paste this link into the agent's chat (copied to the clipboard):"
      echo "    ${ev[1]}"
      printf %s "${ev[1]}" | pbcopy 2>/dev/null || true
      _info "Anyone with the link can use this browser until you stop (Ctrl-C). Pages reach only uploads and hosts you allow."
      [[ -n "${SHARE_CTL:-}" ]] || _warn "The browser did not confirm its control channel: approvals and ${SHARE_DIR}/allow may not reach it."
      echo ;;
    ask)
      local id="${ev[1]:-}" kind="${ev[2]:-}" text
      [[ "$id" =~ ^[0-9a-f]{6}$ && ( "$kind" == hosts || "$kind" == keep ) ]] || return 0
      text="$(_b64d "${ev[3]:-}" | tr -d '\000-\010\013-\037\177')"
      echo; _warn "Request ${id} from the remote agent:"
      printf '%s\n' "$text" | sed 's/^/    /'
      if [[ "$kind" == hosts ]]; then
        _info "Answer in the dialog, or here: aibox browser answer ${id} allow|always|deny"
      else
        _info "Answer in the dialog, or here: aibox browser answer ${id} always (keep) | deny (session only)"
      fi
      echo
      ( _share_dialog "$id" "$kind" "$text" ) &
      SHARE_DIALOGS="${SHARE_DIALOGS:-} ${id}:$!" ;;
    done)
      # Settled (dialog, terminal or timeout): close its dialog if still up.
      local d keep=""
      for d in ${SHARE_DIALOGS:-}; do
        if [[ "${d%%:*}" == "${ev[1]:-}" ]]; then _share_kill "${d#*:}"; else keep="${keep} ${d}"; fi
      done
      SHARE_DIALOGS="$keep" ;;
    persist-hosts)
      mkdir -p "$SHARE_DIR"
      local h
      for h in "${ev[@]:1}"; do
        _valid_host "$h" || continue
        grep -qxF -- "$h" "${SHARE_DIR}/allow" 2>/dev/null || echo "$h" >> "${SHARE_DIR}/allow"
      done
      _ok "Always allowed (saved in ${SHARE_DIR}/allow): ${ev[*]:1}" ;;
    persist-tool)
      name="${ev[1]:-}"
      [[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || return 0
      mkdir -p "${SHARE_DIR}/tools"
      _b64d "${ev[2]:-}" > "${SHARE_DIR}/tools/${name}.json"
      _ok "Kept tool /${name} for future shares (${SHARE_DIR}/tools/${name}.json)" ;;
  esac
}
_share_answer() {
  local ctl="${CONFIG_DIR}/browser.ctl"
  [[ "${1:-}" =~ ^[0-9a-f]{6}$ ]] && [[ "${2:-}" == allow || "${2:-}" == always || "${2:-}" == deny ]] \
    || _die "Usage: aibox browser answer <id> allow|always|deny   (the id is in the request on the browser's terminal)"
  [[ -p "$ctl" ]] && pgrep -u "$RENDER_USER" -f "node serve.js" >/dev/null 2>&1 \
    || _die "No shared browser is running (start one with: aibox browser --share)."
  echo "answer $1 $2" > "$ctl"
  _ok "Sent: $2 for request $1 (the browser's terminal shows the result)."
}

# Foreground, like `aibox sessions`: the server's output (and Chromium's,
# via DEBUG) stays on screen, Ctrl-C ends it, and the advertised URL is
# withdrawn from every container on exit. With "share", also an agent-socket
# link for agents outside this Mac (cloud sessions, other chats).
_browser_run() {
  local share="${1:-}"
  # First run sets up on its own; `aibox browser setup` stays as the update
  # path (latest Playwright and its Chromium). A newer aibox rewrites only
  # its own files.
  if [[ ! -f "${RENDER_HOME}/serve.js" ]]; then
    _info "First run: setting up the '${RENDER_USER}' user, node and Playwright (later updates: aibox browser setup)."
    _browser_setup auto
  elif [[ "$(cat "${RENDER_HOME}/.aibox-rev" 2>/dev/null)" != "$BROWSER_REV" ]]; then
    _info "Updating the browser server's files (sudo may ask for your password)..."
    _browser_files
  fi
  pgrep -u "$RENDER_USER" -f "node serve.js" >/dev/null 2>&1 && _die "A GPU browser server is already running (another terminal?). Stop it there, or: sudo pkill -u ${RENDER_USER} -f 'node serve.js'"
  # The one thing standing between that browser's file:// and your files is
  # your home's mode; check it on every run, not only at setup.
  [[ "$(stat -f %Lp "$HOME")" == "700" ]] || _die "${HOME} is not mode 700, so the '${RENDER_USER}' browser could read it. Fix with: chmod 700 ~"
  local ver line cmd='DEBUG="pw:browser*" node serve.js 2>&1'
  ver="$(cat "${RENDER_HOME}/.pw-version" 2>/dev/null)"
  mkdir -p "${CONFIG_DIR}/host"
  _on_exit _browser_cleanup
  if [[ -n "$share" ]]; then
    local re='^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$'
    [[ "$SHARE_RELAY" =~ $re ]] || _die "share_relay in ${CONFIG_DIR}/config must be an https URL (got: ${SHARE_RELAY})"
    local ctl="${CONFIG_DIR}/browser.ctl"
    rm -f "$ctl" && mkfifo -m 600 "$ctl" || _die "Could not create ${ctl}"
    exec 3<>"$ctl"
    _on_exit _share_cleanup
    SHARE_KEY="$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
    [[ ${#SHARE_KEY} -eq 24 ]] || _die "Could not read /dev/urandom"
    cmd="AIBOX_SHARE=${SHARE_RELAY} AIBOX_SHARE_KEY=${SHARE_KEY} ${cmd}"
    # In the background: a long allowlist or many saved tools must not
    # block on the FIFO before the server starts reading it.
    ( _share_preload >&3 ) &
    SHARE_PRELOAD=$!
    _info "Starting the GPU browser server as '${RENDER_USER}', shared through ${SHARE_RELAY} (sudo may ask for your password). Ctrl-C stops both."
  else
    _info "Starting the GPU browser server as '${RENDER_USER}' (sudo may ask for your password). Ctrl-C stops it."
  fi
  # Process substitution, not a pipe: the loop must run in this shell so
  # BROWSER_UP reaches the exit hook, and macOS's bash 3.2 has no lastpipe.
  while IFS= read -r line; do
    if [[ -n "${SHARE_KEY:-}" && "$line" == "@@aibox:${SHARE_KEY} "* ]]; then _share_event "${line#@@aibox:${SHARE_KEY} }"; continue; fi
    printf '%s\n' "$line"
    if [[ "$line" == *"Listening on ws://"* ]]; then
      BROWSER_UP=1
      printf '%s\n%s\n' "${line##*Listening on }" "$ver" | sed '1s/127\.0\.0\.1/host.docker.internal/' > "${CONFIG_DIR}/host/browser.url"
      _ok "Playwright ${ver}. Every container sees it at ~/.aibox/host/browser.url; CLAUDE.md tells sessions how."
    fi
  done < <(if [[ -n "$share" ]]; then _render_sh "$cmd" <&3; else _render_sh "$cmd"; fi)
}
cmd_browser() {
  [[ "$(uname)" == "Darwin" ]] || _die "aibox browser is macOS-only: it runs a GPU browser on the Mac for sessions. On Linux, run a Playwright server with your GPU yourself and give sessions its URL."
  case "${1:-}" in
    "")              _browser_run ;;
    --share|share)   _browser_run share ;;
    setup)           _browser_setup ;;
    answer)          shift; _share_answer "$@" ;;
    *)               _die "Usage: aibox browser [--share | setup | answer <id> allow|always|deny]   (no argument runs the server in the foreground; Ctrl-C stops it)" ;;
  esac
}

# ── Sessions page (host-side, foreground, all projects) ──────────
# `aibox sessions` runs a small Node server ON THE HOST (node is present by
# construction — aibox installs via npm), loopback-only, and opens the
# browser. Not a daemon: Ctrl-C or the page's Close button ends it. Listing
# is read via a throwaway container with the volume mounted read-only; the
# Terminal/Phone actions shell back into aibox itself.
cmd_sessions() {
  _ensure_docker
  _ensure_image
  command -v node >/dev/null 2>&1 \
    || _die "aibox sessions needs node on the host (it comes with the npm install of aibox)."

  cat > "${CONFIG_DIR}/sessions-lister.js" <<'LISTER'
// Runs inside a container with the aibox-home volume mounted read-only at
// /v (AIBOX_LIST_ROOT overrides the root, for testing outside docker). Prints all projects' sessions
// as JSON on stdout.
const fs = require("fs"), path = require("path");
const ROOT = process.env.AIBOX_LIST_ROOT || "/v";
// Deep search: with AIBOX_SEARCH set, only sessions whose metadata OR full
// transcript contains the (case-insensitive) query are emitted.
const Q = (process.env.AIBOX_SEARCH || "").toLowerCase().slice(0, 200);
function fileHas(p, q) {
  try {
    const fd = fs.openSync(p, "r"), CH = 4 * 1024 * 1024, b = Buffer.alloc(CH);
    // StringDecoder buffers a codepoint split across chunk reads — a plain
    // per-chunk toString would mangle it and silently miss the match.
    const dec = new (require("string_decoder").StringDecoder)("utf8");
    let pos = 0, carry = "";
    for (;;) {
      const n = fs.readSync(fd, b, 0, CH, pos);
      if (n <= 0) break;
      const s = carry + dec.write(b.slice(0, n));
      if (s.toLowerCase().includes(q)) { fs.closeSync(fd); return true; }
      carry = s.slice(-q.length);   // query straddling a chunk boundary
      pos += n;
      if (n < CH) break;
    }
    fs.closeSync(fd);
  } catch (e) {}
  return false;
}
function msgText(m) {
  const c = m.content;
  const t = typeof c === "string" ? c : Array.isArray(c) ? c.map(x => x.text || "").join(" ") : "";
  return t.replace(/\s+/g, " ").trim();
}
function parseLine(l) { try { return JSON.parse(l); } catch (e) { return null; } }
// Title prefers Claude Code's own summary records (what its resume picker
// shows); falls back to the first real user message. `last` is the tail of
// the conversation — the most recent assistant text. Reads only a head and
// a tail window, transcripts can be many MB.
function info(file, size) {
  let head = "", tail = "";
  try {
    const fd = fs.openSync(file, "r");
    const rd = (pos, len) => {
      const b = Buffer.alloc(len), n = fs.readSync(fd, b, 0, len, pos);
      return b.slice(0, n).toString("utf8");
    };
    head = rd(0, 262144);
    if (size > 262144) tail = rd(Math.max(0, size - 131072), 131072);
    fs.closeSync(fd);
  } catch (e) { return { title: "Untitled session", summary: "", last: "", lastUser: "" }; }
  let firstUser = "", summary = "", last = "";
  for (const l of head.split("\n")) {
    const j = parseLine(l); if (!j) continue;
    if (j.type === "summary" && j.summary) summary = j.summary;
    if (!firstUser && j.type === "user" && j.message && !j.isMeta) {
      const t = msgText(j.message);
      if (t && !t.startsWith("Caveat:") && !t.startsWith("<command-")) firstUser = t;
    }
  }
  const tl = (tail || head).split("\n");
  let tailSummary = "", lastUser = "";
  for (let i = tl.length - 1; i >= 0; i--) {
    const j = parseLine(tl[i]); if (!j) continue;
    if (!tailSummary && j.type === "summary" && j.summary) tailSummary = j.summary;
    if (!last && j.type === "assistant" && j.message) {
      const t = msgText(j.message);
      if (t) last = t.slice(0, 2000);
    }
    if (!lastUser && j.type === "user" && j.message && !j.isMeta) {
      const t = msgText(j.message);
      if (t && !t.startsWith("Caveat:") && !t.startsWith("<command-")) lastUser = t.slice(0, 500);
    }
    if (last && lastUser && tailSummary) break;
  }
  const sum = tailSummary || summary;
  return {
    title: (sum || firstUser || "Untitled session").slice(0, 100),
    summary: sum.slice(0, 600),
    last: last,
    lastUser: lastUser
  };
}
const out = [];
function addDir(dir, ppath, label) {
  let files = []; try { files = fs.readdirSync(dir); } catch (e) { return; }
  for (const f of files) {
    if (!f.endsWith(".jsonl")) continue;
    // Filenames are agent-written: only a bare uuid may become an id that
    // the host page later puts into a shell command.
    if (!/^[0-9a-f-]{36}$/.test(f.slice(0, -6))) continue;
    try {
      const p = path.join(dir, f), st = fs.statSync(p), inf = info(p, st.size);
      if (Q) {
        const meta = (inf.title + " " + inf.summary + " " + inf.last + " " + inf.lastUser + " " + label + " " + f).toLowerCase();
        if (!meta.includes(Q) && !fileHas(p, Q)) continue;
      }
      out.push({ project: ppath, label: label, id: f.slice(0, -6), mtime: st.mtimeMs,
                 title: inf.title, summary: inf.summary, last: inf.last, lastUser: inf.lastUser });
    } catch (e) {}
  }
}
// New layout: per-project slices.
let hashes = [];
try { hashes = fs.readdirSync(path.join(ROOT, "projects")); } catch (e) {}
for (const h of hashes) {
  const base = path.join(ROOT, "projects", h);
  // A slice without its .aibox-path sentinel (pre-fix migrations wrote
  // none) is still listed — pathless, so copy-only, labelled by hash.
  let ppath = "";
  try { ppath = fs.readFileSync(path.join(base, ".aibox-path"), "utf8"); } catch (e) {}
  const cp = path.join(base, "claude-projects");
  let encs = []; try { encs = fs.readdirSync(cp); } catch (e) {}
  for (const enc of encs) addDir(path.join(cp, enc), ppath, ppath || "slice " + h);
}
// Legacy / not-yet-migrated layout (and post-migration leftovers). Dir
// names are lossy encodings; real paths come from .claude.json KEYS with
// the same rule the migration uses. Unmatched dirs are listed anyway with
// no project path — the page then offers copy-only.
const legacyRoot = path.join(ROOT, ".claude", "projects");
let legacy = []; try { legacy = fs.readdirSync(legacyRoot); } catch (e) {}
if (legacy.length) {
  const map = {};
  try {
    const cj = fs.readFileSync(path.join(ROOT, ".claude", ".claude.json"), "utf8");
    for (const m of cj.matchAll(/"(\/[^"]*)":/g)) map[m[1].replace(/[^a-zA-Z0-9]/g, "-")] = m[1];
  } catch (e) {}
  for (const enc of legacy) addDir(path.join(legacyRoot, enc), map[enc] || "", map[enc] || enc);
}
